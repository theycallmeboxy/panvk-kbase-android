---
 src/panfrost/vulkan/csf/panvk_cmd_buffer.h  | 15 +++++
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 68 +++++++++++++++++----
 src/panfrost/vulkan/panvk_cmd_draw.h        | 23 +++++++
 3 files changed, 95 insertions(+), 11 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
index 1fd67f7a..ece1f33e 100644
--- a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
@@ -766,6 +766,21 @@ inherits_render_ctx(struct panvk_cmd_buffer *cmdbuf)
 
 void panvk_per_arch(cmd_flush_lazy_compute)(struct panvk_cmd_buffer *cmdbuf);
 
+/* Draw-time IDVS register caching: the index buffer and VARY_SIZE registers
+ * are written only when the value differs from the one they hold
+ * (idvs_reg_cacheable()). PANVK_NO_IDVS_REG_CACHE=1 writes them on every draw
+ * again. */
+static inline bool
+panvk_idvs_reg_cache_enabled(void)
+{
+   static int disabled = -1;
+
+   if (disabled < 0)
+      disabled = debug_get_bool_option("PANVK_NO_IDVS_REG_CACHE", false);
+
+   return !disabled;
+}
+
 /* Barrier sync elision, primary command buffers only (see emit_barrier_csf()).
  * PANVK_NO_SYNC_ELISION=1 turns it off. */
 static inline bool
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index bf91fcb8..7922dbe0 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -2922,16 +2922,61 @@ prepare_dcd(struct panvk_cmd_buffer *cmdbuf,
    }
 }
 
+/* Nothing but prepare_draw() writes the INDEX_BUFFER, INDEX_BUFFER_SIZE and
+ * VARY_SIZE registers, so they keep the last values written at the top level
+ * of the CS, and a draw can skip writing the same values again. Draws
+ * generated by gpu_prerast and indirect draws may be recorded inside CS loops
+ * or conditionals: they always write the registers and leave them unknown.
+ * Inside a block a skipped write could also see a value written later in the
+ * same loop, so only top-level draws use the cache. Command buffer begin,
+ * secondary execution and CS segment cuts clear it with the dirty state
+ * (gfx_state_set_all_dirty()).
+ */
+static bool
+idvs_reg_cacheable(struct cs_builder *b, const struct panvk_draw_info *draw)
+{
+   return panvk_idvs_reg_cache_enabled() && !draw->gpu_prerast_generated &&
+          !draw->indirect.buffer_dev_addr && cs_cur_block(b) == NULL;
+}
+
 static void
-prepare_index_buffer(struct cs_builder *b,
-                     const struct panvk_draw_info *draw)
+prepare_index_buffer(struct panvk_cmd_buffer *cmdbuf, struct cs_builder *b,
+                     const struct panvk_draw_info *draw, bool cacheable)
 {
-   if (draw->index.index_size) {
-      cs_move32_to(b, cs_sr_reg32(b, IDVS, INDEX_BUFFER_SIZE),
-                   draw->index.buffer_size);
-      cs_move64_to(b, cs_sr_reg64(b, IDVS, INDEX_BUFFER),
-                   draw->index.buffer_dev_addr);
-   }
+   if (!draw->index.index_size)
+      return;
+
+   struct panvk_cmd_graphics_state *gfx = &cmdbuf->state.gfx;
+   const uint64_t addr = draw->index.buffer_dev_addr;
+   const uint32_t size = (uint32_t)draw->index.buffer_size;
+
+   if (cacheable && gfx->idvs_regs.ib_valid &&
+       gfx->idvs_regs.ib_addr == addr && gfx->idvs_regs.ib_size == size)
+      return;
+
+   cs_move32_to(b, cs_sr_reg32(b, IDVS, INDEX_BUFFER_SIZE), size);
+   cs_move64_to(b, cs_sr_reg64(b, IDVS, INDEX_BUFFER), addr);
+
+   gfx->idvs_regs.ib_addr = addr;
+   gfx->idvs_regs.ib_size = size;
+   gfx->idvs_regs.ib_valid = cacheable;
+}
+
+static void
+prepare_vary_size(struct panvk_cmd_buffer *cmdbuf, struct cs_builder *b,
+                  const struct panvk_shader_variant *vs, bool cacheable)
+{
+   struct panvk_cmd_graphics_state *gfx = &cmdbuf->state.gfx;
+   const uint32_t vary_size = vs->info.varyings.formats.generic_size_B;
+
+   if (cacheable && gfx->idvs_regs.vary_size_valid &&
+       gfx->idvs_regs.vary_size == vary_size)
+      return;
+
+   cs_move32_to(b, cs_sr_reg32(b, IDVS, VARY_SIZE), vary_size);
+
+   gfx->idvs_regs.vary_size = vary_size;
+   gfx->idvs_regs.vary_size_valid = cacheable;
 }
 
 static void
@@ -3132,12 +3177,13 @@ prepare_draw(struct panvk_cmd_buffer *cmdbuf,
    prepare_fs(cmdbuf, fs);
 
    cs_update_vt_ctx(b) {
-      prepare_index_buffer(b, draw);
+      const bool idvs_cacheable = idvs_reg_cacheable(b, draw);
+
+      prepare_index_buffer(cmdbuf, b, draw, idvs_cacheable);
 
       set_tiler_idvs_flags(b, cmdbuf, draw);
 
-      cs_move32_to(b, cs_sr_reg32(b, IDVS, VARY_SIZE),
-                   vs->info.varyings.formats.generic_size_B);
+      prepare_vary_size(cmdbuf, b, vs, idvs_cacheable);
 
       struct pan_earlyzs_state earlyzs = {0};
 
diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index f6d6a2d0..40f57acb 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -252,6 +252,20 @@ struct panvk_cmd_graphics_state {
       uint8_t index_size;
    } ib;
 
+#if PAN_ARCH >= 10
+   /* What the IDVS INDEX_BUFFER, INDEX_BUFFER_SIZE and VARY_SIZE registers
+    * hold, when known (see idvs_reg_cacheable()). Cleared with the dirty
+    * state wherever the register state becomes unknown.
+    */
+   struct {
+      uint64_t ib_addr;
+      uint32_t ib_size;
+      uint32_t vary_size;
+      bool ib_valid;
+      bool vary_size_valid;
+   } idvs_regs;
+#endif
+
    struct {
       struct panvk_blend_info info;
    } cb;
@@ -303,8 +317,17 @@ panvk_prerast_viewport_shader(const struct panvk_cmd_graphics_state *gfx)
 #define gfx_state_clear_all_dirty(__cmdbuf)                                    \
    BITSET_ZERO((__cmdbuf)->state.gfx.dirty)
 
+#if PAN_ARCH >= 10
+#define gfx_state_set_all_dirty(__cmdbuf)                                      \
+   do {                                                                        \
+      BITSET_ONES((__cmdbuf)->state.gfx.dirty);                                \
+      (__cmdbuf)->state.gfx.idvs_regs.ib_valid = false;                        \
+      (__cmdbuf)->state.gfx.idvs_regs.vary_size_valid = false;                 \
+   } while (0)
+#else
 #define gfx_state_set_all_dirty(__cmdbuf)                                      \
    BITSET_ONES((__cmdbuf)->state.gfx.dirty)
+#endif
 
 #define set_gfx_sysval(__cmdbuf, __dirty, __name, __val)                       \
    do {                                                                        \
