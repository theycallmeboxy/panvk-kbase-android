                                  float priority)
 {
 }
+
+static void
+emul_coherent_sync(struct panvk_device *dev, enum pan_kmod_bo_sync_type type)
+{
+   simple_mtx_lock(&dev->emul_cc.lock);
+
+   bool queued = false;
+   list_for_each_entry(struct panvk_device_memory, mem, &dev->emul_cc.list,
+                       emul_cc_link) {
+      if (!mem->addr.host)
+         continue;
+
+      pan_kmod_queue_bo_map_sync(mem->bo, 0, mem->addr.host,
+                                 pan_kmod_bo_size(mem->bo), type);
+      queued = true;
+   }
+
+   /* Run the ops while the mappings can't go away. */
+   if (queued)
+      pan_kmod_flush_bo_map_syncs(dev->kmod.dev);
+
+   simple_mtx_unlock(&dev->emul_cc.lock);
+}
+
+void
+panvk_emul_coherent_flush(struct panvk_device *dev)
+{
+   emul_coherent_sync(dev, PAN_KMOD_BO_SYNC_CPU_CACHE_FLUSH);
+}
+
+void
+panvk_emul_coherent_invalidate(struct panvk_device *dev)
+{
+   /* Clean as well as invalidate: CPU writes made since the last submission
+    * must not be dropped. */
+   emul_coherent_sync(dev, PAN_KMOD_BO_SYNC_CPU_CACHE_FLUSH_AND_INVALIDATE);
+}
