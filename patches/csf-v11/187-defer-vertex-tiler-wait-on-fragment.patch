+/* Conservative: any texture instruction or image/SSBO/global/texel-buffer
+ * intrinsic counts. */
+static bool
+shader_accesses_memory(nir_shader *nir)
+{
+   nir_foreach_function_impl(impl, nir) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type == nir_instr_type_tex)
+               return true;
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            const char *name =
+               nir_intrinsic_infos[nir_instr_as_intrinsic(instr)->intrinsic].name;
+            if (strstr(name, "invocation_id"))
+               continue;
+            if (strstr(name, "image") || strstr(name, "ssbo") ||
+                strstr(name, "global") || strstr(name, "texel") ||
+                strstr(name, "bindless"))
+               return true;
+         }
+      }
+   }
+   return false;
+}
