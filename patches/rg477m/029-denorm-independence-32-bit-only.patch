+/*
+ * Copyright 2026 theycallmeboxy
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "bi_builder.h"
+#include "bi_test.h"
+#include "compiler.h"
+
+#include <gtest/gtest.h>
+
+/* reg, x, y, z are SSA values 0-3 in both shaders; values without a producer
+ * stand for loads, which may hold denormals. */
+#define CASE(instr, expected)                                                  \
+   INSTRUCTION_CASE(                                                           \
+      {                                                                        \
+         UNUSED bi_index reg = bi_temp(b->shader);                             \
+         UNUSED bi_index x = bi_temp(b->shader);                               \
+         UNUSED bi_index y = bi_temp(b->shader);                               \
+         UNUSED bi_index z = bi_temp(b->shader);                               \
+         instr;                                                                \
+         bi_kaboom(b, reg);                                                    \
+      },                                                                       \
+      {                                                                        \
+         UNUSED bi_index reg = bi_temp(b->shader);                             \
+         UNUSED bi_index x = bi_temp(b->shader);                               \
+         UNUSED bi_index y = bi_temp(b->shader);                               \
+         UNUSED bi_index z = bi_temp(b->shader);                               \
+         expected;                                                             \
+         bi_kaboom(b, reg);                                                    \
+      },                                                                       \
+      bi_emulate_ftz_fp16);
+
+#define NEGCASE(instr) CASE(instr, instr)
+
+static bi_index
+ftz(bi_builder *b, bi_index dest, bi_index src)
+{
+   bi_instr *I = bi_flush_to(b, 16, dest, src);
+   I->ftz = true;
+   return I->dest[0];
+}
+
+class EmulateFtzFp16 : public testing::Test {
+ protected:
+   EmulateFtzFp16()
+   {
+      mem_ctx = ralloc_context(NULL);
+      arch = 11;
+   }
+
+   ~EmulateFtzFp16()
+   {
+      ralloc_free(mem_ctx);
+   }
+
+   void *mem_ctx;
+   unsigned arch;
+};
+
+TEST_F(EmulateFtzFp16, OperandsAndResult)
+{
+   CASE(bi_fadd_v2f16_to(b, reg, x, y), {
+      bi_index fx = ftz(b, bi_temp(b->shader), x);
+      bi_index fy = ftz(b, bi_temp(b->shader), y);
+      bi_index t = bi_temp(b->shader);
+      bi_fadd_v2f16_to(b, t, fx, fy);
+      ftz(b, reg, t);
+   });
+}
+
+TEST_F(EmulateFtzFp16, ModifiersStayOnOperand)
+{
+   CASE(bi_fadd_v2f16_to(b, reg, bi_neg(bi_half(x, true)), bi_abs(y)), {
+      bi_index fx = ftz(b, bi_temp(b->shader), x);
+      bi_index fy = ftz(b, bi_temp(b->shader), y);
+      bi_index t = bi_temp(b->shader);
+      bi_fadd_v2f16_to(b, t, bi_neg(bi_half(fx, true)), bi_abs(fy));
+      ftz(b, reg, t);
+   });
+}
+
+TEST_F(EmulateFtzFp16, FlushedResultIsNotFlushedAgain)
+{
+   CASE(
+      {
+         bi_index s = bi_fadd_v2f16(b, x, x);
+         bi_fma_v2f16_to(b, reg, s, s, bi_negzero());
+      },
+      {
+         bi_index s = bi_temp(b->shader);
+         bi_index fx = ftz(b, bi_temp(b->shader), x);
+         bi_index fx2 = ftz(b, bi_temp(b->shader), x);
+         bi_index t = bi_temp(b->shader);
+         bi_fadd_v2f16_to(b, t, fx, fx2);
+         ftz(b, s, t);
+         bi_index t2 = bi_temp(b->shader);
+         bi_fma_v2f16_to(b, t2, s, s, bi_negzero());
+         ftz(b, reg, t2);
+      });
+}
+
+TEST_F(EmulateFtzFp16, DenormalConstants)
+{
+   CASE(bi_fadd_v2f16_to(b, reg, bi_imm_u32(0x83ff0001), bi_imm_u32(0x3c000400)),
+        {
+           bi_index t = bi_temp(b->shader);
+           bi_fadd_v2f16_to(b, t, bi_imm_u32(0x80000000),
