 #include <errno.h>
+#include <inttypes.h>
+#include <signal.h>
 #include <string.h>
+#include <unistd.h>
 #include <xf86drm.h>
 
+#include "c11/threads.h"
 #include "util/cache_ops.h"
+#include "util/os_file.h"
+#include "util/os_misc.h"
+#include "util/u_debug.h"
