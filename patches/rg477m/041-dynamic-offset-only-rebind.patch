+#if PAN_ARCH >= 10
+/* DXVK rebinds the set it already bound with new dynamic offsets whenever
+ * only constant-buffer offsets change. If every set in the call is the one
+ * bound at its index (same handle, still with the layout and descriptor
+ * memory it was bound with), bind them as cmd_desc_state_bind_sets() does
+ * and, instead of DESC_STATE, record which dynamic buffers moved: the draw
+ * then rebuilds only the tables of the stages reading one of them
+ * (stage_dyn_offs_dirty() in csf/panvk_vX_cmd_draw.c). The descriptor
+ * state ends up the same as with the full bind. Returns false, having
+ * changed nothing, if any set differs.
+ */
+static bool
+gfx_rebind_sets_dyn_offsets(struct panvk_cmd_buffer *cmdbuf,
+                            const VkBindDescriptorSetsInfoKHR *info)
+{
+   struct panvk_descriptor_state *desc_state = &cmdbuf->state.gfx.desc_state;
+   uint32_t changed[MAX_SETS];
+   uint32_t any_changed = 0;
+   unsigned dynoffset_idx = 0;
+
+   for (unsigned i = 0; i < info->descriptorSetCount; ++i) {
+      unsigned set_idx = i + info->firstSet;
+      VK_FROM_HANDLE(panvk_descriptor_set, set, info->pDescriptorSets[i]);
+
+      if (!set || set != desc_state->sets[set_idx] ||
+          set == desc_state->push_sets[set_idx] ||
+          set->layout != desc_state->bound[set_idx].layout ||
+          set->descs.dev != desc_state->bound[set_idx].descs_dev)
+         return false;
+
+      changed[set_idx] = 0;
+      for (unsigned b = 0; b < set->layout->dyn_buf_count; b++) {
+         if (desc_state->dyn_buf_offsets[set_idx][b] !=
+             info->pDynamicOffsets[dynoffset_idx++])
+            changed[set_idx] |= BITFIELD_BIT(b);
+      }
+      any_changed |= changed[set_idx];
+   }
+
+   cmd_desc_state_bind_sets(desc_state, info);
+
+   /* Same sets, same offsets: nothing a draw reads changed. */
+   if (!any_changed)
+      return true;
+
+   if (!gfx_state_dirty(cmdbuf, DYN_OFFSETS))
+      memset(desc_state->dyn_offs_changed, 0,
+             sizeof(desc_state->dyn_offs_changed));
+
+   for (unsigned i = 0; i < info->descriptorSetCount; ++i)
+      desc_state->dyn_offs_changed[i + info->firstSet] |=
+         changed[i + info->firstSet];
+
+   gfx_state_set_dirty(cmdbuf, DYN_OFFSETS);
+   return true;
+}
+#endif
