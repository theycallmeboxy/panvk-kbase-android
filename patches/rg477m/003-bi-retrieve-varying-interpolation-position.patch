 extern unsigned bifrost_debug;
 
diff --git a/src/panfrost/compiler/bifrost/bifrost_compile.c b/src/panfrost/compiler/bifrost/bifrost_compile.c
index d7adf88..e06da8b 100644
--- a/src/panfrost/compiler/bifrost/bifrost_compile.c
+++ b/src/panfrost/compiler/bifrost/bifrost_compile.c
@@ -602,6 +602,74 @@ bi_emit_load_var(bi_builder *b, nir_intrinsic_instr *intr)
    bi_split_def(b, &intr->def);
 }
 
+/* Every interpolated varying load is emitted with .store, which recomputes the
+ * interpolation position and writes it to the hidden varying state. A load
+ * that writes that state has to wait for all outstanding varying loads (see
+ * va_insert_flow.c), so a shader reading several varyings serializes them.
+ * Within a block, once a load has stored the position for a sample mode, later
+ * loads with the same mode can retrieve it instead: no recompute, no wait.
+ * Varying-heavy fragment shaders (e.g. UV + colour) run ~1.6x faster on G615.
+ */
+static bool
+va_is_interp_varying_load(const bi_instr *I)
+{
+   switch (I->op) {
+   case BI_OPCODE_LD_VAR_BUF_IMM_F32:
+   case BI_OPCODE_LD_VAR_BUF_IMM_F16:
+   case BI_OPCODE_LD_VAR_BUF_F32:
+   case BI_OPCODE_LD_VAR_BUF_F16:
+      return I->source_format == BI_SOURCE_FORMAT_F32 ||
+             I->source_format == BI_SOURCE_FORMAT_F16;
+   case BI_OPCODE_LD_VAR_IMM:
+   case BI_OPCODE_LD_VAR:
+      return true;
+   default:
+      return false;
+   }
+}
+
+static void
+va_retrieve_varying_position(bi_context *ctx)
+{
+   bi_foreach_block(ctx, block) {
+      bool stored = false;
+      enum bi_sample sample = BI_SAMPLE_CENTER;
+      bi_index sample_src = bi_null();
+
+      bi_foreach_instr_in_block(block, I) {
+         if (va_is_interp_varying_load(I) && I->update == BI_UPDATE_STORE &&
+             I->sample != BI_SAMPLE_EXPLICIT) {
+            /* Only centre interpolation retrieves: a .retrieve load with the
+             * centroid or sample mode faults the shader core with
+             * INSTR_INVALID_ENC on G615 (Pseudoregalia, UE5), like the fused
+             * VAR_TEX encodings, which have no centroid/sample retrieve. */
+            if (stored && I->sample == sample && sample == BI_SAMPLE_CENTER) {
+               I->update = BI_UPDATE_RETRIEVE;
+            } else {
+               stored = true;
+               sample = I->sample;
+               sample_src = I->src[0];
+            }
+            continue;
+         }
+
+         /* Anything else that may touch the hidden state (flat loads keep
+          * .store, special varyings clobber it, fused VAR_TEX) or redefine the
+          * sample index ends the run conservatively.
+          */
+         if (bi_get_opcode_props(I)->message == BIFROST_MESSAGE_VARYING ||
+             I->op == BI_OPCODE_VAR_TEX_F32 || I->op == BI_OPCODE_VAR_TEX_F16)
+            stored = false;
+
+         bi_foreach_dest(I, d) {
+            if (stored && sample == BI_SAMPLE_SAMPLE &&
+                bi_is_equiv(I->dest[d], sample_src))
+               stored = false;
+         }
+      }
+   }
+}
+
 static void
 bi_emit_load_var_buf(bi_builder *b, nir_intrinsic_instr *intr)
 {
@@ -4469,6 +4537,14 @@ bi_compile_variant_nir(nir_shader *nir,
    bi_opt_control_flow(ctx);
 
    if (ctx->arch >= 9) {
+      /* Only valid on the final instruction order: varying loads carry no
+       * ordering dependencies, so the schedulers may move a retrieving load
+       * above the load that stores the position, and DCE may delete the
+       * storing load. Run after scheduling, RA and the post-RA cleanups. */
+      if (ctx->stage == MESA_SHADER_FRAGMENT &&
+          !(bifrost_debug & BIFROST_DBG_NORETRIEVE))
+         va_retrieve_varying_position(ctx);
+
       va_assign_slots(ctx);
       va_insert_flow_control_nops(ctx);
       va_merge_flow(ctx);
