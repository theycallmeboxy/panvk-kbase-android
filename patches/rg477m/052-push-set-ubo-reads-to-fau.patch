+
+            bool known = false;
+            for (uint32_t i = 0; i < desc_info->pushable_set_ubo_count; i++)
+               known |= desc_info->pushable_set_ubos[i] == handle;
+
+            if (!known &&
+                desc_info->pushable_set_ubo_count < PAN_MAX_PUSHABLE_SET_UBOS)
+               desc_info->pushable_set_ubos
+                  [desc_info->pushable_set_ubo_count++] = handle;
+         }
+      }
+   }
+#endif
+}
