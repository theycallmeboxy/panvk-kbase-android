+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -1759,6 +1759,9 @@ panvk_per_arch(CmdExecuteCommands)(VkCommandBuffer commandBuffer,
     * stores of the current pass (zs_untouched_skip_end()). */
    primary->state.gfx.render.zs_skip.touched |=
       VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
