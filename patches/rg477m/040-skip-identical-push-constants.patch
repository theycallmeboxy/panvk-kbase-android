 src/panfrost/vulkan/csf/panvk_cmd_buffer.h    | 14 ++++
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c |  9 +++
 src/panfrost/vulkan/panvk_cmd_push_constant.h | 14 ++++
 src/panfrost/vulkan/panvk_vX_cmd_meta.c       |  4 ++
