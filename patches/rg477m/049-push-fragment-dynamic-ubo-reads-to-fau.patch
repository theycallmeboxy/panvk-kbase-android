+/* Constant-offset reads of dynamic uniform buffers (DXVK binds every D3D
+ * constant buffer as one) can be moved to the FAU like push constants: the
+ * compiler records which UBO words it pushed (pan_fau_layout relocations), and
+ * the command stream copies them from the bound buffers into the shader's FAU
+ * right before the draw (copy_pushed_ubos()). Saves a load/store message per
+ * read in fragment shaders that are load/store-bound on their constants.
+ * Fragment shaders only: a D3D9 vertex shader pushes dozens of vec4s, and
+ * copying them for every draw costs more command-stream time than the loads
+ * it saves (Portal 2 184 -> 150 fps, Tomb Raider 74.9 -> 71.5).
+ * PANVK_NO_UBO_PUSH=1 keeps them as loads. */
+static void
+panvk_set_pushable_ubos(struct pan_compile_inputs *inputs,
+                        const struct panvk_shader_desc_info *desc_info)
+{
+#if PAN_ARCH >= 9
+   static int disabled = -1;
+
+   if (disabled < 0)
+      disabled = debug_get_bool_option("PANVK_NO_UBO_PUSH", false);
+
+   if (!disabled) {
+      inputs->fau.pushable_ubos = desc_info->pushable_ubos;
+      inputs->fau.no_blend_const_ubo = true;
+   }
+#endif
+}
+
