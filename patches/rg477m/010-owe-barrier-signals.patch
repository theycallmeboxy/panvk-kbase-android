From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: theycallmeboxy <82409831+theycallmeboxy@users.noreply.github.com>
Date: Sun, 11 Oct 2026 21:39:12 -0400
Subject: [PATCH] panvk/csf: owe barrier signals that only deferred waits
 target

With the vertex/tiler fragment wait and the idle compute subqueue waits
deferred, most render-pass barriers still made the fragment subqueue
signal its sync object although nothing waits on it until much later.
A signal costs about as much as a short render pass setup on the command
stream frontend.

When every wait on a subqueue's barrier signal is deferred, record the
sync point as owed instead of signaling. Any later signal on that
subqueue reaches it: the barrier already waited for its earlier work and
flushed before going on, and the point is only reached once a signal
issued after the barrier ran. A wait on an owed point that no signal
reached yet emits it first, and so do the end of the command buffer and
vkCmdExecuteCommands(). Only with sync elision (PANVK_NO_SYNC_ELISION=1
turns it off), never for the compute subqueue's own signal.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QAYrqSPd4TgpVaKLqz5cYR

Purpose: record barrier signals that only deferred waits target as owed sync points instead of signaling; emit them only when a wait needs them first
Upstream-commit: none (generic PanVK CSF; upstream candidate)
Tested GPU: Mali-G615 MC6 (Anbernic RG477M, Dimensity 8300, v11)
Tested Kbase UAPI: CSF 1.21 / MediaTek
Dependencies: rg477m/009
Validation test: drawbench loadpasses 64 at 1255 MHz 1.22 -> 1.04 ms; Hades Vulkan renderer 1255 MHz 160.0 -> 170.3 fps, normal clocks 51.5 -> 59.6 fps; Hades DXVK 103.2 -> 103.3 fps at 502 MHz; Serious Sam (189-191 together) Vulkan 51.9 -> 52.9, D3D11 46.5 -> 47.0 fps; racetest incl. direct render pass -> vertex shader 0/100 stale, controls 100/100; drawbench image checksums unchanged; PanProbe 38/38
Generated-by: LLM
---
 src/panfrost/vulkan/csf/panvk_cmd_buffer.h    |  7 ++
 src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c | 78 ++++++++++++++++---
 2 files changed, 76 insertions(+), 9 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
index cb4a93c..9e4aa4a 100644
--- a/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/csf/panvk_cmd_buffer.h
@@ -498,6 +498,13 @@ struct panvk_cs_state {
     */
    int32_t waited_sync_point[PANVK_SUBQUEUE_COUNT];
 
+   /* A barrier signal skipped because every waiter deferred its wait: the
+    * sync point those waits target. Any later signal on this subqueue
+    * reaches it (barriers wait for earlier work and flush before going on),
+    * so one is only emitted when a wait needs it first.
+    */
+   int32_t owed_sync_point;
+
    /* Compute only: true while the subqueue has done nothing since its last
     * barrier signal but wait on other subqueues (idle_ins_count is the
     * instruction count after those waits). Such a subqueue skips its
diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
index ad721b8..8197179 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_buffer.c
@@ -158,6 +158,40 @@ sync_elision_enabled(const struct panvk_cmd_buffer *cmdbuf)
    return !disabled && cmdbuf->vk.level == VK_COMMAND_BUFFER_LEVEL_PRIMARY;
 }
 
+/* The sync point a wait on subqueue j's work so far must target. */
+static int32_t
+target_sync_point(const struct panvk_cmd_buffer *cmdbuf,
+                  enum panvk_subqueue_id j)
+{
+   return MAX2(cmdbuf->state.cs[j].relative_sync_point,
+               cmdbuf->state.cs[j].owed_sync_point);
+}
+
+static void
+emit_owed_signal(struct panvk_cmd_buffer *cmdbuf, enum panvk_subqueue_id j)
+{
+   struct panvk_cs_state *cs_state = &cmdbuf->state.cs[j];
+
+   if (cs_state->owed_sync_point <= cs_state->relative_sync_point)
+      return;
+
+   /* Not panvk_get_cs_builder(): this is a signal, not compute work. */
+   struct cs_builder *b = &cs_state->builder;
+   struct cs_index sync_addr = cs_scratch_reg64(b, 0);
+   struct cs_index add_val = cs_scratch_reg64(b, 2);
+
+   assert(!cs_cur_block(b));
+   assert(cs_state->owed_sync_point == cs_state->relative_sync_point + 1);
+
+   cs_load64_to(b, sync_addr, cs_subqueue_ctx_reg(b),
+                offsetof(struct panvk_cs_subqueue_context, syncobjs));
+   cs_add_imm64(b, sync_addr, sync_addr, sizeof(struct panvk_cs_sync64) * j);
+   cs_move64_to(b, add_val, 1);
+   panvk_instr_sync64_add(cmdbuf, j, true, MALI_CS_SYNC_SCOPE_CSG, add_val,
+                          sync_addr, cs_now());
+   ++cs_state->relative_sync_point;
+}
+
 static void
 emit_cache_flush(struct cs_builder *b, struct panvk_cmd_buffer *cmdbuf,
                  enum panvk_subqueue_id i,
@@ -189,6 +223,9 @@ emit_cache_flush(struct cs_builder *b, struct panvk_cmd_buffer *cmdbuf,
 static void
 flush_sync_points(struct panvk_cmd_buffer *cmdbuf)
 {
+   for (uint32_t j = 0; j < PANVK_SUBQUEUE_COUNT; j++)
+      emit_owed_signal(cmdbuf, j);
+
    for (uint32_t i = 0; i < ARRAY_SIZE(cmdbuf->state.cs); i++) {
       struct cs_builder *b = panvk_get_cs_builder(cmdbuf, i);
 
@@ -215,6 +252,7 @@ flush_sync_points(struct panvk_cmd_buffer *cmdbuf)
       struct panvk_cs_state *cs_state = &cmdbuf->state.cs[i];
 
       cs_state->relative_sync_point = 0;
+      cs_state->owed_sync_point = 0;
 
       /* Recorded waits are relative to the old sync points. The deferred
        * compute waits were emitted by panvk_get_cs_builder() above. */
@@ -771,6 +809,10 @@ emit_subqueue_wait(struct cs_builder *b, struct panvk_cmd_buffer *cmdbuf,
    if (elide && cs_state->waited_sync_point[j] > sync_point)
       return;
 
+   if (sync_point > cmdbuf->state.cs[j].relative_sync_point)
+      emit_owed_signal(cmdbuf, j);
+   assert(sync_point <= cmdbuf->state.cs[j].relative_sync_point);
+
    struct cs_index sync_addr = cs_reg64(b, tmp_regs.reg);
    struct cs_index wait_val = cs_reg64(b, tmp_regs.reg + 2);
 
@@ -948,6 +990,20 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
       panvk_per_arch(panvk_instr_begin_work)(i, cmdbuf,
                                              PANVK_INSTR_WORK_TYPE_BARRIER);
 
+   const bool cq_signaled = !cq_skip && (wait_subqueue_mask & BITFIELD_BIT(cq));
+   const uint32_t cq_wait_mask = deps.dst[cq].wait_subqueue_mask;
+   const bool cq_defer_waits =
+      cq_defer && (cq_idle || cq_signaled) && cq_wait_mask;
+
+   /* Subqueues waited on right away. A signal that only deferred waits
+    * (vertex/tiler fragment wait, idle compute waits) target is owed
+    * instead (see owed_sync_point). */
+   uint32_t wait_now_mask = 0;
+   for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
+      if (!(i == cq && cq_defer_waits))
+         wait_now_mask |= deps.dst[i].wait_subqueue_mask;
+   }
+
    /* Subqueues that emitted nothing but barriers since their last flush. */
    uint32_t flush_clean_mask = 0;
    for (uint32_t i = 0; i < PANVK_SUBQUEUE_COUNT; i++) {
@@ -981,8 +1037,15 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
          }
       }
 
-      /* If no one waits on us, there's no point signaling the sync object. */
-      if ((wait_subqueue_mask & BITFIELD_BIT(i)) && !(i == cq && cq_skip)) {
+      /* If no one waits on us, there's no point signaling the sync object.
+       * If only deferred waits target the signal, owe it instead. */
+      const bool needs_signal =
+         (wait_subqueue_mask & BITFIELD_BIT(i)) && !(i == cq && cq_skip);
+      if (needs_signal && elide && i != cq &&
+          !(wait_now_mask & BITFIELD_BIT(i))) {
+         assert(deps.src[i].wait_sb_mask);
+         cs_state->owed_sync_point = cs_state->relative_sync_point + 1;
+      } else if (needs_signal) {
          struct cs_index sync_addr = cs_scratch_reg64(b, 0);
          struct cs_index add_val = cs_scratch_reg64(b, 2);
 
@@ -999,15 +1062,12 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
       }
    }
 
-   const bool cq_signaled = !cq_skip && (wait_subqueue_mask & BITFIELD_BIT(cq));
-   const uint32_t cq_wait_mask = deps.dst[cq].wait_subqueue_mask;
-
    /* Idle from here on: defer its waits. */
-   if (cq_defer && (cq_idle || cq_signaled) && cq_wait_mask) {
+   if (cq_defer_waits) {
       u_foreach_bit(j, cq_wait_mask) {
          cq_state->lazy_wait_points[j] =
             MAX2(cq_state->lazy_wait_points[j],
-                 cmdbuf->state.cs[j].relative_sync_point + 1);
+                 target_sync_point(cmdbuf, j) + 1);
       }
       cq_state->lazy_waits = true;
       deps.dst[cq].wait_subqueue_mask = 0;
@@ -1016,7 +1076,7 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
    if (lazy_vt || vt_lazy_inherited) {
       struct panvk_cs_state *vt = &cmdbuf->state.cs[PANVK_SUBQUEUE_VERTEX_TILER];
       const int32_t point =
-         lazy_vt ? cmdbuf->state.cs[PANVK_SUBQUEUE_FRAGMENT].relative_sync_point
+         lazy_vt ? target_sync_point(cmdbuf, PANVK_SUBQUEUE_FRAGMENT)
                  : vt_lazy_inherited - 1;
 
       vt->lazy_frag_sync_point =
@@ -1070,7 +1130,7 @@ emit_barrier_csf(struct panvk_cmd_buffer *cmdbuf, struct panvk_cs_deps deps)
          u_foreach_bit(j, cq_wait_mask) {
             cq_state->idle_waits[j] =
                MAX2(cq_state->idle_waits[j],
-                    cmdbuf->state.cs[j].relative_sync_point + 1);
+                    target_sync_point(cmdbuf, j) + 1);
          }
          cq_state->idle_ins_count = cq_b->ins_count;
       }
