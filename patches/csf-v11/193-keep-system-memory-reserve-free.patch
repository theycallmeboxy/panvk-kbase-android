@@ -130,12 +137,147 @@ pan_kmod_dev_destroy(struct pan_kmod_dev *dev)
    dev->ops->dev_destroy(dev);
 }
 
+/* GPU memory guard.
+ *
+ * The kernel's OOM handling can't get GPU memory back in time: kbase only
+ * returns a process's GPU pages when its GPU context is torn down at exit, so
+ * when a process allocates GPU memory until the system runs out, killing it
+ * frees nothing quickly and the OOM killer works its way through the rest of
+ * the system until the kernel panics (a game took ~9 GB of GPU memory on an
+ * 8 GB device this way). Keep a reserve of system memory free instead, so an
+ * out-of-memory situation ends in this process rather than in the system:
+ *
+ *  - an allocation that would take MemAvailable below the reserve fails, and
+ *    the app gets VK_ERROR_OUT_OF_DEVICE_MEMORY;
+ *  - if MemAvailable is below half the reserve anyway (memory growing outside
+ *    our allocations, or an app retrying regardless) while this process holds
+ *    more than that in GPU buffers, the process kills itself: its GPU memory
+ *    is freed on exit and nothing else is touched.
+ *
+ * The reserve is RAM / 8 clamped to [768 MiB, 2 GiB] (8 GB: 1 GiB, 16 GB:
+ * 2 GiB), or PAN_MEM_RESERVE_MB (0 disables the guard). MemAvailable is read
+ * once per 64 MiB of new allocations, and on every allocation once below the
+ * reserve.
+ */
+#define PAN_MEM_CHECK_STEP (64ull << 20)
+
+static struct {
+   once_flag once;
+   uint64_t reserve;
+   uint64_t held;
+   uint64_t unchecked;
+   uint32_t low;
+   uint32_t refusals;
+   /* Live accounted BOs by log2(size), for the diagnostic. */
+   uint32_t live[64];
+} pan_mem = { .once = ONCE_FLAG_INIT };
+
+static void
+pan_mem_init(void)
+{
+   int64_t mb = debug_get_num_option("PAN_MEM_RESERVE_MB", -1);
+   uint64_t total;
+
+   if (mb >= 0)
+      pan_mem.reserve = (uint64_t)mb << 20;
+   else if (os_get_total_physical_memory(&total))
+      pan_mem.reserve = CLAMP(total / 8, 768ull << 20, 2048ull << 20);
+
+   mesa_logi("pan_kmod: GPU memory guard keeps %" PRIu64 " MiB free%s",
+             pan_mem.reserve >> 20, pan_mem.reserve ? "" : " (disabled)");
+}
+
+uint64_t
+pan_kmod_mem_reserve(void)
+{
+   call_once(&pan_mem.once, pan_mem_init);
+   return pan_mem.reserve;
+}
+
+static void
+pan_mem_log(const char *what, uint64_t size, uint32_t flags, uint64_t avail)
+{
+   char sizes[512];
+   int n = 0;
+
+   sizes[0] = '\0';
+   for (unsigned i = 0; i < ARRAY_SIZE(pan_mem.live); i++) {
+      uint32_t count = p_atomic_read(&pan_mem.live[i]);
+      if (count && n < (int)sizeof(sizes))
+         n += snprintf(sizes + n, sizeof(sizes) - n, " %" PRIu64 "K:%u",
+                       (uint64_t)1 << i >> 10, count);
+   }
+
+   mesa_loge("pan_kmod: %s: request %" PRIu64 " KiB (flags 0x%x), "
+             "MemAvailable %" PRIu64 " MiB, reserve %" PRIu64 " MiB, "
+             "this process holds %" PRIu64 " MiB of GPU buffers; "
+             "live buffers by size class:%s",
+             what, size >> 10, flags, avail >> 20, pan_mem.reserve >> 20,
+             p_atomic_read(&pan_mem.held) >> 20, sizes);
+}
+
+/* Returns false if the allocation must fail to keep the reserve free. */
+static bool
+pan_mem_admit(uint64_t size, uint32_t flags)
+{
+   if (!pan_kmod_mem_reserve())
+      return true;
+
+   uint64_t pending = p_atomic_add_return(&pan_mem.unchecked, size);
+   if (!p_atomic_read(&pan_mem.low) && pending < PAN_MEM_CHECK_STEP)
+      return true;
+
+   p_atomic_set(&pan_mem.unchecked, 0);
+
+   uint64_t avail;
+   if (!os_get_available_system_memory(&avail))
+      return true;
+
+   if (avail < pan_mem.reserve / 2 &&
+       p_atomic_read(&pan_mem.held) > pan_mem.reserve / 2) {
+      pan_mem_log("system memory critically low, killing this process to "
+                  "release its GPU memory", size, flags, avail);
+      kill(getpid(), SIGKILL);
+   }
+
+   if (avail < pan_mem.reserve + size) {
+      p_atomic_set(&pan_mem.low, 1);
+      uint32_t refusals = p_atomic_inc_return(&pan_mem.refusals);
+      if (refusals == 1 || !(refusals & 255))
+         pan_mem_log("GPU allocation refused to keep system memory free",
+                     size, flags, avail);
+      return false;
+   }
+
+   p_atomic_set(&pan_mem.low, 0);
+   return true;
+}
+
+static void
+pan_mem_account(struct pan_kmod_bo *bo, bool add)
+{
+   unsigned class = MIN2(util_logbase2_64(MAX2(bo->size, 1)),
+                         ARRAY_SIZE(pan_mem.live) - 1);
+
+   if (add) {
+      bo->mem_accounted = true;
+      p_atomic_add(&pan_mem.held, bo->size);
+      p_atomic_inc(&pan_mem.live[class]);
+   } else {
+      p_atomic_add(&pan_mem.held, -bo->size);
+      p_atomic_dec(&pan_mem.live[class]);
+   }
+}
+
 struct pan_kmod_bo *
 pan_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
                   uint64_t size, uint32_t flags)
 {
    struct pan_kmod_bo *bo;
 
+   if (!pan_mem_admit(size, flags))
+      return NULL;
+
    bo = dev->ops->bo_alloc(dev, exclusive_vm, size, flags);
    if (!bo)
       return NULL;
@@ -155,6 +297,7 @@ pan_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
 
    assert(*slot == NULL);
    *slot = bo;
+   pan_mem_account(bo, true);
    return bo;
 }
 
@@ -184,6 +327,8 @@ pan_kmod_bo_put(struct pan_kmod_bo *bo)
 
       assert(slot);
       *slot = NULL;
+      if (bo->mem_accounted)
+         pan_mem_account(bo, false);
       bo->dev->ops->bo_free(bo);
    }
 
