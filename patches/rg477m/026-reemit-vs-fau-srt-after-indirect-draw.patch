---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index 7922dbe0..8aebbb5a 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -5970,10 +5970,22 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
    if (!draw.prims_generated_counted)
       update_prims_generated_query(cmdbuf, &draw);
 
-   if (draw.indirect.buffer_dev_addr)
+   if (draw.indirect.buffer_dev_addr) {
       launch_indirect_draw(cmdbuf, &draw);
-   else
+
+      /* The draw loop advanced VERTEX_FAU (when it patched first_vertex or
+       * base_instance into the FAU copies) and VERTEX_SRT (with repeated
+       * descriptors) once per draw, so they now point past the last copy,
+       * and the copies hold the GPU-patched values of the indirect draws.
+       * Make the next draw upload fresh push uniforms and rebuild the VS
+       * tables, which rewrites both registers.
+       */
+      gfx_state_set_dirty(cmdbuf, VS_PUSH_UNIFORMS);
+      if (cmdbuf->state.gfx.vs.desc_repeat_count)
+         gfx_state_set_dirty(cmdbuf, VB);
+   } else {
       launch_draw(cmdbuf, &draw);
+   }
 }
 
