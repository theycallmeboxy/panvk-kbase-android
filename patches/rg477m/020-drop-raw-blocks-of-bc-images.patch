+static void
+bc_noraw_warn_once(const char *what)
+{
+   static bool warned;
+   if (!p_atomic_xchg(&warned, true))
+      mesa_logw("panvk: %s from a BC image without raw blocks "
+                "(PANVK_BC_DROP_RAW) is not supported, skipped", what);
+}
+
+/* Copy the decoded texels of BC images. A region covering a whole level of
+ * the same size on both sides copies the decoded plane's bytes: AFRC is fixed
+ * rate and the decoded layouts match, so the copy is exact (engines stream
+ * mips this way). Other regions take a nearest-filter blit between the
+ * bc_shadow images, which re-encodes AFRC and so is close but not exact;
+ * regions are clamped to both levels' extents (compressed copy extents may
+ * round up to whole blocks). */
+static void
+bc_copy_decoded(VkCommandBuffer commandBuffer, const VkCopyImageInfo2 *info,
+                struct panvk_image *src, struct panvk_image *dst)
+{
+   STACK_ARRAY(VkImageBlit2, blits, info->regionCount);
+   uint32_t n = 0;
+   const bool same_layout =
+      src->bc_format == dst->bc_format &&
+      src->bc_decoded.image.props.modifier ==
+         dst->bc_decoded.image.props.modifier;
+
+   for (uint32_t i = 0; i < info->regionCount; i++) {
+      const VkImageCopy2 *r = &info->pRegions[i];
+      const VkExtent3D se =
+         vk_image_mip_level_extent(&src->vk, r->srcSubresource.mipLevel);
+      const VkExtent3D de =
+         vk_image_mip_level_extent(&dst->vk, r->dstSubresource.mipLevel);
+
+      if (same_layout && se.width == de.width && se.height == de.height &&
+          !r->srcOffset.x && !r->srcOffset.y && !r->dstOffset.x &&
+          !r->dstOffset.y && r->extent.width >= se.width &&
+          r->extent.height >= se.height) {
+         const struct pan_image_layout *sl = &src->bc_decoded.plane.layout;
+         const struct pan_image_layout *dl = &dst->bc_decoded.plane.layout;
+         const struct pan_image_slice_layout *ss =
+            &sl->slices[r->srcSubresource.mipLevel];
+         const struct pan_image_slice_layout *ds =
+            &dl->slices[r->dstSubresource.mipLevel];
+         const uint32_t layers =
+            r->srcSubresource.layerCount == VK_REMAINING_ARRAY_LAYERS
+               ? src->vk.array_layers - r->srcSubresource.baseArrayLayer
+               : r->srcSubresource.layerCount;
+
+         if (ss->size_B == ds->size_B) {
+            STACK_ARRAY(VkDeviceMemoryCopyKHR, mc, layers);
+            for (uint32_t l = 0; l < layers; l++) {
+               mc[l] = (VkDeviceMemoryCopyKHR){
+                  .sType = VK_STRUCTURE_TYPE_DEVICE_MEMORY_COPY_KHR,
+                  .srcRange = {src->bc_decoded.plane.base + ss->offset_B +
+                                  (r->srcSubresource.baseArrayLayer + l) *
+                                     sl->array_stride_B,
+                               ss->size_B},
+                  .dstRange = {dst->bc_decoded.plane.base + ds->offset_B +
+                                  (r->dstSubresource.baseArrayLayer + l) *
+                                     dl->array_stride_B,
+                               ds->size_B},
+               };
+            }
+            const VkCopyDeviceMemoryInfoKHR copy = {
+               .sType = VK_STRUCTURE_TYPE_COPY_DEVICE_MEMORY_INFO_KHR,
+               .regionCount = layers,
+               .pRegions = mc,
+            };
+            panvk_per_arch(CmdCopyMemoryKHR)(commandBuffer, &copy);
+            STACK_ARRAY_FINISH(mc);
+            continue;
+         }
+      }
+      const int32_t w = MIN3((int32_t)r->extent.width,
+                             (int32_t)se.width - r->srcOffset.x,
+                             (int32_t)de.width - r->dstOffset.x);
+      const int32_t h = MIN3((int32_t)r->extent.height,
+                             (int32_t)se.height - r->srcOffset.y,
+                             (int32_t)de.height - r->dstOffset.y);
+
+      if (w <= 0 || h <= 0)
+         continue;
+
+      blits[n++] = (VkImageBlit2){
+         .sType = VK_STRUCTURE_TYPE_IMAGE_BLIT_2,
+         .srcSubresource = r->srcSubresource,
+         .srcOffsets = {r->srcOffset,
+                        {r->srcOffset.x + w, r->srcOffset.y + h, 1}},
+         .dstSubresource = r->dstSubresource,
+         .dstOffsets = {r->dstOffset,
+                        {r->dstOffset.x + w, r->dstOffset.y + h, 1}},
+      };
+   }
+
+   if (n) {
+      const VkBlitImageInfo2 blit = {
+         .sType = VK_STRUCTURE_TYPE_BLIT_IMAGE_INFO_2,
+         .srcImage = src->bc_shadow,
+         .srcImageLayout = info->srcImageLayout,
+         .dstImage = dst->bc_shadow,
+         .dstImageLayout = info->dstImageLayout,
+         .regionCount = n,
+         .pRegions = blits,
+         .filter = VK_FILTER_NEAREST,
+      };
+      panvk_per_arch(CmdBlitImage2)(commandBuffer, &blit);
+   }
+   STACK_ARRAY_FINISH(blits);
+}
+
+/* CmdCopyImage2 when either image is a bc_noraw image. */
+static void
+copy_image_bc_noraw(VkCommandBuffer commandBuffer,
+                    const VkCopyImageInfo2 *info)
+{
+   VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+   VK_FROM_HANDLE(panvk_image, src, info->srcImage);
+   VK_FROM_HANDLE(panvk_image, dst, info->dstImage);
+   const bool src_blocks = vk_format_is_compressed(src->vk.format);
+
+   if (src->bc_noraw) {
+      /* Only the decoded texels exist: they can go to another decoded
+       * copy, never back to blocks. */
+      if (dst->bc_gfx)
+         bc_copy_decoded(commandBuffer, info, src, dst);
+      else
+         bc_noraw_warn_once("copy to a non-BC or compute-decoded image");
+      return;
+   }
+
+   /* dst has no raw plane: decode straight from the source's blocks. */
+   if (!src_blocks || !src->bc_emul) {
+      bc_noraw_warn_once("copy from an uncompressed image into one");
+      return;
+   }
+
+   struct panvk_cmd_meta_graphics_save_ctx save = {0};
+
+   meta_gfx_start(cmdbuf, &save);
+   for (uint32_t i = 0; i < info->regionCount; i++) {
+      const VkImageCopy2 *r = &info->pRegions[i];
+      const struct bc_decode_src s =
+         bc_raw_plane_src(src, &r->srcSubresource, r->srcOffset);
+
+      bc_decode_region_gfx(cmdbuf, dst, &r->dstSubresource, r->dstOffset,
+                           r->extent, &s);
+   }
+   meta_gfx_end(cmdbuf, &save);
+}
+
