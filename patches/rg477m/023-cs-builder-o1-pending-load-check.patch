---
 src/panfrost/genxml/cs_builder.h | 57 ++++++++++++++++++++++++--------
 1 file changed, 43 insertions(+), 14 deletions(-)

diff --git a/src/panfrost/genxml/cs_builder.h b/src/panfrost/genxml/cs_builder.h
index cfd839c3..ecb3bfc5 100644
--- a/src/panfrost/genxml/cs_builder.h
+++ b/src/panfrost/genxml/cs_builder.h
@@ -608,11 +608,9 @@ cs_reserve_instrs(struct cs_builder *b, uint32_t num_instrs)
    return true;
 }
 
-static inline void *
-cs_alloc_ins_block(struct cs_builder *b, uint32_t num_instrs)
+static ATTRIBUTE_NOINLINE UNUSED void *
+cs_alloc_ins_block_slow(struct cs_builder *b, uint32_t num_instrs)
 {
-   b->ins_count += num_instrs;
-
    if (cs_cur_block(b))
       return util_dynarray_grow(&b->blocks.instrs, uint64_t, num_instrs);
 
@@ -625,6 +623,29 @@ cs_alloc_ins_block(struct cs_builder *b, uint32_t num_instrs)
    return b->cur_chunk.buffer.cpu + pos;
 }
 
+static ALWAYS_INLINE void *
+cs_alloc_ins_block(struct cs_builder *b, uint32_t num_instrs)
+{
+   b->ins_count += num_instrs;
+
+   /* Fast path, taken by nearly every instruction: no block is open and the
+    * current chunk of a growable CS still has room for the instructions plus
+    * a chunk-linking sequence. cs_reserve_instrs() would return true without
+    * doing anything in that case, so skip it.
+    */
+   uint32_t pos = b->cur_chunk.pos;
+   if (likely(cs_cur_block(b) == NULL && cs_is_valid(b) &&
+              b->conf.alloc_buffer != NULL && b->cur_chunk.buffer.cpu != NULL &&
+              pos + num_instrs + JUMP_SEQ_INSTR_COUNT <=
+                 b->cur_chunk.buffer.capacity)) {
+      assert(num_instrs > 0);
+      b->cur_chunk.pos = pos + num_instrs;
+      return b->cur_chunk.buffer.cpu + pos;
+   }
+
+   return cs_alloc_ins_block_slow(b, num_instrs);
+}
+
 static inline void
 cs_flush_block_instrs(struct cs_builder *b)
 {
@@ -964,22 +985,30 @@ cs_wait_slot(struct cs_builder *b, unsigned slot)
    cs_wait_slots(b, BITFIELD_BIT(slot));
 }
 
-static inline void
+static ALWAYS_INLINE void
 cs_flush_load_to(struct cs_builder *b, struct cs_index to, uint16_t mask)
 {
    struct cs_load_store_tracker *ls_tracker = b->cur_ls_tracker;
    assert(ls_tracker != NULL);
 
-   unsigned count = util_last_bit(mask);
-   unsigned reg = cs_to_reg_tuple(to, count);
+   unsigned reg = cs_to_reg_tuple(to, util_last_bit(mask));
 
-   for (unsigned i = reg; i < reg + count; i++) {
-      if ((mask & BITFIELD_BIT(i - reg)) &&
-          BITSET_TEST(ls_tracker->pending_loads, i)) {
-         cs_wait_slots(b, BITFIELD_BIT(b->conf.ls_sb_slot));
-         break;
-      }
-   }
+   /* This runs for every register operand of every instruction, so test the
+    * at most 16 registers of the mask in one go instead of bit by bit: the
+    * bits [reg, reg + 16) of the pending-load bitset lie in at most two
+    * consecutive words.
+    */
+   const unsigned nr_words = ARRAY_SIZE(ls_tracker->pending_loads);
+   const unsigned word = reg / BITSET_WORDBITS;
+   const unsigned shift = reg % BITSET_WORDBITS;
+   assert(word < nr_words);
+
+   uint64_t pending = ls_tracker->pending_loads[word];
+   if (word + 1 < nr_words)
+      pending |= (uint64_t)ls_tracker->pending_loads[word + 1] << BITSET_WORDBITS;
+
+   if (unlikely((pending >> shift) & mask))
+      cs_wait_slots(b, BITFIELD_BIT(b->conf.ls_sb_slot));
 }
 
 static inline void
