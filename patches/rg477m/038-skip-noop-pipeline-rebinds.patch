+/* DXVK binds the graphics pipeline whenever its pipeline state is dirty,
+ * without checking whether the handle changed, so many binds rebind the
+ * pipeline already bound. Such a rebind changes nothing when no shader
+ * changed since the last bind and no state the pipeline has as static was
+ * written since: the shader bind then compares equal pointers and
+ * vk_dynamic_graphics_state_copy() equal values, at about 100 branches per
+ * bind. The written bitset (set on every value change, cleared here after
+ * each real bind) says whether such a state was written, in any order with
+ * other binds, vk_meta or vkCmdSet*() calls: a value change anywhere sets
+ * it. PANVK_NO_REBIND_SKIP=1 runs every bind.
+ */
+static bool
+rebind_skip_enabled(void)
+{
+   static int disabled = -1;
+
+   if (disabled < 0)
+      disabled = debug_get_bool_option("PANVK_NO_REBIND_SKIP", false);
+
+   return !disabled;
+}
+
+#define REBIND_GFX_STAGES                                                     \
+   (VK_SHADER_STAGE_ALL_GRAPHICS | VK_SHADER_STAGE_TASK_BIT_EXT |              \
+    VK_SHADER_STAGE_MESH_BIT_EXT)
+
+static void
+cmd_bind_gfx_pipeline(struct panvk_cmd_buffer *cmdbuf,
+                      VkPipeline _pipeline)
+{
+   VK_FROM_HANDLE(vk_pipeline, pipeline, _pipeline);
+   struct panvk_cmd_graphics_state *gfx = &cmdbuf->state.gfx;
+   struct vk_dynamic_graphics_state *dyn = &cmdbuf->vk.dynamic_graphics_state;
+   const struct vk_dynamic_graphics_state *bind_state =
+      vk_graphics_pipeline_get_bind_state(pipeline);
+
+   if (bind_state != NULL && gfx->bound_pipeline.pipeline == pipeline &&
+       gfx->bound_pipeline.vs == gfx->vs.shader &&
+       gfx->bound_pipeline.fs == gfx->fs.shader &&
+       gfx->bound_pipeline.gs == gfx->gs.shader &&
+       gfx->bound_pipeline.tcs == gfx->tcs.shader &&
+       gfx->bound_pipeline.tes == gfx->tes.shader &&
+       gfx->bound_pipeline.stages ==
+          (cmdbuf->vk.pipeline_shader_stages & REBIND_GFX_STAGES)) {
+      BITSET_DECLARE(overwritten, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX);
+
+      BITSET_AND(overwritten, dyn->written, bind_state->set);
+      if (BITSET_IS_EMPTY(overwritten))
+         return;
+   }
+
+   vk_common_CmdBindPipeline(panvk_cmd_buffer_to_handle(cmdbuf),
+                             VK_PIPELINE_BIND_POINT_GRAPHICS, _pipeline);
+
+   BITSET_ZERO(dyn->written);
+   gfx->bound_pipeline.pipeline = bind_state != NULL ? pipeline : NULL;
+   gfx->bound_pipeline.vs = gfx->vs.shader;
+   gfx->bound_pipeline.fs = gfx->fs.shader;
+   gfx->bound_pipeline.gs = gfx->gs.shader;
+   gfx->bound_pipeline.tcs = gfx->tcs.shader;
+   gfx->bound_pipeline.tes = gfx->tes.shader;
+   gfx->bound_pipeline.stages =
+      cmdbuf->vk.pipeline_shader_stages & REBIND_GFX_STAGES;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+panvk_per_arch(CmdBindPipeline)(VkCommandBuffer commandBuffer,
+                                VkPipelineBindPoint pipelineBindPoint,
+                                VkPipeline _pipeline)
+{
+   VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+
+   if (pipelineBindPoint == VK_PIPELINE_BIND_POINT_GRAPHICS &&
+       rebind_skip_enabled()) {
+      cmd_bind_gfx_pipeline(cmdbuf, _pipeline);
+      return;
+   }
+
+   vk_common_CmdBindPipeline(commandBuffer, pipelineBindPoint, _pipeline);
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
                                     const VkDependencyInfo *pDependencyInfo)
