+/* A same-set rebind moved a dynamic buffer the stage reads (DYN_OFFSETS,
+ * see gfx_rebind_sets_dyn_offsets()). */
+static bool
+stage_dyn_offs_dirty(const struct panvk_cmd_buffer *cmdbuf,
+                     const struct panvk_shader_desc_info *desc_info)
+{
+   if (!gfx_state_dirty(cmdbuf, DYN_OFFSETS))
+      return false;
+
+   const struct panvk_descriptor_state *desc_state =
+      &cmdbuf->state.gfx.desc_state;
+
+   for (uint32_t i = 0; i < desc_info->dyn_bufs.count; i++) {
+      uint32_t handle = desc_info->dyn_bufs.map[i];
+      uint32_t set_idx = COPY_DESC_HANDLE_EXTRACT_TABLE(handle);
+      uint32_t dyn_buf_idx = COPY_DESC_HANDLE_EXTRACT_INDEX(handle);
+
+      if (desc_state->dyn_offs_changed[set_idx] & BITFIELD_BIT(dyn_buf_idx))
+         return true;
+   }
+
+   return false;
+}
+
+/* Rebuild a stage's driver set and resource table when only its dynamic
+ * buffers moved: the caller checked that none of the stage's other dirty
+ * conditions hold, so everything else in the previous tables is what a full
+ * rebuild would write again. Copy the previous driver set, repack its
+ * dynamic buffer descriptors (at dyn_first), copy the previous resource
+ * table and point its first entry at the new driver set. The set entries
+ * stay valid: the rebind kept every set (gfx_rebind_sets_dyn_offsets()).
+ * Returns VK_INCOMPLETE, having done nothing, if there are no single-copy
+ * previous tables to start from.
+ */
+static VkResult
+stage_patch_dyn_bufs(struct panvk_cmd_buffer *cmdbuf,
+                     const struct panvk_shader_desc_info *desc_info,
+                     struct panvk_shader_desc_state *shader_desc,
+                     uint32_t dyn_first)
+{
+   const uint32_t size = shader_desc->driver_set.size;
+   const uint32_t res_count = panvk_shader_res_table_count(shader_desc);
+
+   if (!shader_desc->driver_set.cpu || !shader_desc->res_table_cpu ||
+       size < (dyn_first + desc_info->dyn_bufs.count) * PANVK_DESCRIPTOR_SIZE)
+      return VK_INCOMPLETE;
+
+   struct pan_ptr driver_set = panvk_cmd_alloc_dev_mem(
+      cmdbuf, desc, size, PANVK_DESCRIPTOR_SIZE);
+   if (!driver_set.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   struct pan_ptr res_table =
+      panvk_cmd_alloc_desc_array(cmdbuf, res_count, RESOURCE);
+   if (!res_table.gpu)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   struct panvk_opaque_desc *descs = driver_set.cpu;
+   memcpy(descs, shader_desc->driver_set.cpu, size);
+   panvk_per_arch(cmd_fill_dyn_bufs)(
+      &cmdbuf->state.gfx.desc_state, desc_info,
+      (struct mali_buffer_packed *)(&descs[dyn_first]));
+
+   struct mali_resource_packed *res = res_table.cpu;
+   pan_pack(&res[0], RESOURCE, cfg) {
+      cfg.address = driver_set.gpu;
+      cfg.size = size;
+      cfg.contains_descriptors = size > 0;
+   }
+   memcpy(&res[1],
+          (const struct mali_resource_packed *)shader_desc->res_table_cpu + 1,
+          (res_count - 1) * pan_size(RESOURCE));
+
+   shader_desc->driver_set.dev_addr = driver_set.gpu;
+   shader_desc->driver_set.cpu = driver_set.cpu;
+   shader_desc->res_table = res_table.gpu | res_count;
+   shader_desc->res_table_cpu = res_table.cpu;
+   return VK_SUCCESS;
+}
