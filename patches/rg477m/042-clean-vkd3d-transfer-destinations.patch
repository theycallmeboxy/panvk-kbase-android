+/* vkd3d-proton zero-fills every new host-visible allocation, suballocations
+ * included, with a CPU memset it never flushes, also in the non-coherent
+ * cached type it puts READBACK heaps in. Those dirty lines later land over
+ * what the GPU wrote (on eviction, or through the clean+invalidate of
+ * vkInvalidateMappedMemoryRanges), so readbacks come back zero in 64-byte
+ * runs. D3D12 creates a resource, memset included, before any command can
+ * use it, and READBACK resources can only be copy destinations: cleaning the
+ * destination range of each transfer when it is recorded writes the zeros
+ * out before the GPU runs, at a cost proportional to the bytes copied. The
+ * driver-coherent type (016) would also fix it, but cleans every mapped
+ * 16 MiB chunk on each submission (-8% in Serious Sam's D3D12 renderer). */
+void
+panvk_clean_transfer_dst(struct panvk_device *dev,
+                         const struct panvk_buffer *buf, uint64_t offset,
+                         uint64_t size)
+{
+   struct panvk_device_memory *mem = buf->mem;
+
+   if (!mem || !mem->cached_nc || !size)
+      return;
+
+   simple_mtx_lock(&dev->emul_cc.lock);
+   if (mem->addr.host) {
+      uint64_t start = buf->mem_offset + offset;
+      uint64_t bo_size = pan_kmod_bo_size(mem->bo);
+
+      if (start < bo_size) {
+         size = MIN2(size, bo_size - start);
+         pan_kmod_queue_bo_map_sync(mem->bo, start,
+                                    (char *)mem->addr.host + start, size,
+                                    PAN_KMOD_BO_SYNC_CPU_CACHE_FLUSH);
+         pan_kmod_flush_bo_map_syncs(dev->kmod.dev);
+      }
+   }
+   simple_mtx_unlock(&dev->emul_cc.lock);
+}
