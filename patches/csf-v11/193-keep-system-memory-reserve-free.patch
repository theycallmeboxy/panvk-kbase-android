@@ -713,6 +718,11 @@ struct pan_kmod_bo *pan_kmod_bo_alloc(struct pan_kmod_dev *dev,
                                       struct pan_kmod_vm *exclusive_vm,
                                       uint64_t size, uint32_t flags);
 
+/* System memory (bytes) that the GPU memory guard keeps free, 0 if the guard
+ * is disabled. See pan_kmod.c.
+ */
+uint64_t pan_kmod_mem_reserve(void);
+
 static inline struct pan_kmod_bo *
 pan_kmod_bo_get(struct pan_kmod_bo *bo)
 {
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 6369027..ac02ab5 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -1758,10 +1758,18 @@ panvk_GetPhysicalDeviceMemoryProperties2(
           */
          p->heapUsage[0] = used;
 
-         /* Set the budget at 90% of available to avoid thrashing */
-         p->heapBudget[0] = vk_physical_device_heap_budget(
-            panvk_available_system_memory(physical_device), 0.9f, heap_size,
-            used);
+         /* Budget what is available above the reserve the GPU memory guard
+          * keeps free (allocations past it fail), or 90% of what is
+          * available if the guard is off. Never 0, as the spec requires.
+          */
+         uint64_t available = panvk_available_system_memory(physical_device);
+         uint64_t reserve = pan_kmod_mem_reserve();
+         if (reserve)
+            available = available > reserve ? available - reserve : 0;
+         p->heapBudget[0] = MAX2(vk_physical_device_heap_budget(
+                                    available, reserve ? 1.0f : 0.9f,
+                                    heap_size, used),
+                                 1ull << 20);
 
          /* From the Vulkan 1.3.278 spec:
           *
