+/* The id under which the analysis and the relocations know a pushable UBO:
+ * its resource table 0 index (pushable_ubos), or PAN_SET_UBO_ID_BASE + i for
+ * the i-th handle of pushable_set_ubos. -1 if loads from it can't be pushed. */
+static int
+bi_pushable_ubo_id(bi_context *ctx, uint32_t handle)
+{
+   unsigned ubo = pan_res_handle_get_index(handle);
+
+   if (pan_res_handle_get_table(handle) == 0)
+      return ubo < 32 && ctx->inputs->fau.pushable_ubos & BITFIELD_BIT(ubo)
+                ? ubo
+                : -1;
+
+   for (unsigned i = 0; i < ctx->inputs->fau.pushable_set_ubo_count; i++) {
+      if (ctx->inputs->fau.pushable_set_ubos[i] == handle)
+         return PAN_SET_UBO_ID_BASE + i;
+   }
+
+   return -1;
+}
