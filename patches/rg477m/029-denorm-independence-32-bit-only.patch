+/*
+ * Whether a 32-bit float value was produced by FMA-pipe arithmetic (FADD,
+ * FMA), whose result the shader's FTZ mode has already flushed, possibly
+ * through fneg/fabs/fsat, which become source modifiers, a clamp or another
+ * FADD. FADD with a constant operand is left out because it may become
+ * FADD_IMM.
+ */
+static bool
+bi_nir_is_ftz_flushed_fp32(nir_def *def, unsigned depth)
+{
+   if (def->bit_size != 32 || !nir_def_is_alu(def) || depth > 4)
+      return false;
+
+   nir_alu_instr *alu = nir_def_as_alu(def);
+
+   switch (alu->op) {
+   case nir_op_fmul:
+   case nir_op_ffma:
+      return true;
+   case nir_op_fadd:
+      return !nir_src_is_const(alu->src[0].src) &&
+             !nir_src_is_const(alu->src[1].src);
+   case nir_op_fneg:
+   case nir_op_fabs:
+   case nir_op_fsat:
+      return bi_nir_is_ftz_flushed_fp32(alu->src[0].src.ssa, depth + 1);
+   default:
+      return false;
+   }
+}
