+           ftz(b, reg, t);
+        });
+}
+
+TEST_F(EmulateFtzFp16, SelectsDoNotFlush)
+{
+   CASE(bi_csel_v2f16_to(b, reg, x, y, z, x, BI_CMPF_LT), {
+      bi_index fx = ftz(b, bi_temp(b->shader), x);
+      bi_index fy = ftz(b, bi_temp(b->shader), y);
+      bi_csel_v2f16_to(b, reg, fx, fy, z, x, BI_CMPF_LT);
+   });
+
+   NEGCASE(bi_mov_i32_to(b, reg, x));
+}
+
+TEST_F(EmulateFtzFp16, Fp32ToFp16)
+{
+   /* FADD.f32 into one half is the Valhall f32 -> f16 conversion */
+   CASE(bi_fadd_f32_to(b, bi_half(reg, true), x, bi_negzero()), {
+      bi_index t = bi_temp(b->shader);
+      bi_fadd_f32_to(b, bi_half(t, true), x, bi_negzero());
+      ftz(b, reg, bi_half(t, true));
+   });
+
+   /* Plain FP32 arithmetic is left alone */
+   NEGCASE(bi_fadd_f32_to(b, reg, x, y));
+}
+
+TEST_F(EmulateFtzFp16, Fp16ToFp32)
+{
+   CASE(bi_f16_to_f32_to(b, reg, bi_half(x, true)), {
+      bi_index fx = ftz(b, bi_temp(b->shader), x);
+      bi_f16_to_f32_to(b, reg, bi_half(fx, true));
+   });
+}
+
+TEST_F(EmulateFtzFp16, ValidatesInContext)
+{
+   bi_builder *b = bit_builder(mem_ctx, arch);
+   bi_index x = bi_mov_i32(b, bi_register(1));
+   bi_index y = bi_mov_i32(b, bi_register(2));
+   bi_index z = bi_mov_i32(b, bi_register(3));
+   bi_index h = bi_fadd_v2f16(b, bi_half(x, false), y);
+   bi_index m = bi_fma_v2f16(b, h, bi_neg(y), bi_imm_u32(0x00010001));
+   bi_index c = bi_temp(b->shader);
+   bi_fadd_f32_to(b, bi_half(c, false), z, bi_negzero());
+   bi_index w = bi_f16_to_f32(b, bi_half(m, true));
+   bi_index s = bi_csel_v2f16(b, m, c, x, y, BI_CMPF_LT);
+   bi_kaboom(b, bi_fadd_f32(b, w, bi_mov_i32(b, s)));
+
+   bi_emulate_ftz_fp16(b->shader);
+   bi_validate(b->shader, "test");
+
+   unsigned flushes = 0;
+   bi_foreach_instr_global(b->shader, I)
+      flushes += I->op == BI_OPCODE_FLUSH_V2F16 && I->ftz;
+
+   /* Operands: x and y into the FADD, y into the FMA. Results: FADD, FMA and
+    * the f32->f16 conversion. The CSEL compares two flushed results. */
+   EXPECT_EQ(flushes, 3 + 3);
+}
diff --git a/src/panfrost/compiler/pan_compiler.c b/src/panfrost/compiler/pan_compiler.c
index 8c99ff42..412e6dab 100644
--- a/src/panfrost/compiler/pan_compiler.c
+++ b/src/panfrost/compiler/pan_compiler.c
@@ -354,17 +354,31 @@ pan_shader_update_info(struct pan_shader_info *info, nir_shader *s,
    info->ftz_fp32 = nir_is_denorm_flush_to_zero(execution_mode, 32);
 
    if (arch >= 9) {
-      /* Valhall hardware doesn't have a "flush FP16, preserve FP32" mode, and
-       * we don't advertise independent FP16/FP32 denorm modes in panvk, but
-       * it's still possible to have shaders that don't specify any denorm mode
-       * for FP32. In that case, default to flush FP32. */
-      if (info->ftz_fp16 && !info->ftz_fp32) {
-         assert(!nir_is_denorm_preserve(execution_mode, 32));
+      if (pan_emulate_ftz_fp16(arch, execution_mode)) {
+         /* Run with denormals preserved, the compiler flushes FP16 */
+         info->ftz_fp16 = false;
+      } else if (info->ftz_fp16 && !info->ftz_fp32) {
+         /* FP32 has no denorm mode, so flushing it is allowed */
          info->ftz_fp32 = true;
       }
    }
 }
 
+/*
+ * Valhall's FTZ modes are "preserve", DX11 (flush FP32, preserve FP16) and
+ * "always" (flush both); there is no "flush FP16, preserve FP32" mode. A
+ * shader that asks for exactly that (DenormFlushToZero 16 + DenormPreserve 32,
+ * legal once the driver reports a denormBehaviorIndependence other than NONE)
+ * runs with denormals preserved, and the compiler flushes FP16 explicitly:
+ * bi_emulate_ftz_fp16().
+ */
+bool
+pan_emulate_ftz_fp16(unsigned arch, unsigned float_controls)
+{
+   return arch >= 9 && nir_is_denorm_flush_to_zero(float_controls, 16) &&
+          nir_is_denorm_preserve(float_controls, 32);
+}
+
 void
 pan_shader_compile(nir_shader *s, struct pan_compile_inputs *inputs,
                    struct util_dynarray *binary, struct pan_shader_info *info)
