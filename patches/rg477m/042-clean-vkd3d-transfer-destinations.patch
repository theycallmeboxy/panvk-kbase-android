+/* Buffer copies and image-to-buffer copies go through the runtime (which
+ * turns them into memory copies); clean their destinations first, see
+ * panvk_clean_transfer_dst(). */
+VKAPI_ATTR void VKAPI_CALL
+panvk_per_arch(CmdCopyBuffer2)(VkCommandBuffer commandBuffer,
+                               const VkCopyBufferInfo2 *pCopyBufferInfo)
+{
+   VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+   VK_FROM_HANDLE(panvk_buffer, dst, pCopyBufferInfo->dstBuffer);
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+
+   for (uint32_t i = 0; i < pCopyBufferInfo->regionCount; i++) {
+      panvk_clean_transfer_dst(dev, dst, pCopyBufferInfo->pRegions[i].dstOffset,
+                               pCopyBufferInfo->pRegions[i].size);
+   }
+
+   vk_common_CmdCopyBuffer2(commandBuffer, pCopyBufferInfo);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+panvk_per_arch(CmdCopyImageToBuffer2)(
+   VkCommandBuffer commandBuffer,
+   const VkCopyImageToBufferInfo2 *pCopyImageToBufferInfo)
+{
+   VK_FROM_HANDLE(panvk_cmd_buffer, cmdbuf, commandBuffer);
+   VK_FROM_HANDLE(panvk_image, img, pCopyImageToBufferInfo->srcImage);
+   VK_FROM_HANDLE(panvk_buffer, dst, pCopyImageToBufferInfo->dstBuffer);
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+
+   for (uint32_t i = 0; i < pCopyImageToBufferInfo->regionCount; i++) {
+      const VkBufferImageCopy2 *region = &pCopyImageToBufferInfo->pRegions[i];
+      const struct vk_image_buffer_layout layout =
+         vk_image_buffer_copy_layout(&img->vk, region);
+      const VkExtent3D elem_extent =
+         vk_image_extent_to_elements(&img->vk, region->imageExtent);
+
+      panvk_clean_transfer_dst(
+         dev, dst, region->bufferOffset,
+         vk_image_buffer_range(&img->vk, &layout, &elem_extent,
+                               &region->imageSubresource));
+   }
+
+   vk_common_CmdCopyImageToBuffer2(commandBuffer, pCopyImageToBufferInfo);
+}
