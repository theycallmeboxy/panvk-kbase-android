@@ -616,6 +616,9 @@ panvk_per_arch(cmd_init_render_state)(struct panvk_cmd_buffer *cmdbuf,
    memset(&render->z_attachment, 0, sizeof(render->z_attachment));
    memset(&render->s_attachment, 0, sizeof(render->s_attachment));
