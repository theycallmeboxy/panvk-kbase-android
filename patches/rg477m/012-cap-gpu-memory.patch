 #include "util/u_memory.h"
 #include "util/macros.h"
 #include "pan_kmod.h"
@@ -130,12 +138,217 @@ pan_kmod_dev_destroy(struct pan_kmod_dev *dev)
    dev->ops->dev_destroy(dev);
 }
 
+/* GPU memory guard.
+ *
+ * The kernel's OOM handling can't get GPU memory back in time: GPU pages can't
+ * be swapped, and kbase only returns a process's GPU pages when its GPU
+ * context is torn down at exit, so when a process allocates GPU memory until
+ * the system runs out, killing it frees nothing quickly and the OOM killer
+ * works its way through the rest of the system until the kernel panics (a
+ * game took ~9 GB of GPU memory on an 8 GB device this way). So that an
+ * out-of-memory situation ends in this process rather than in the system:
+ *
+ *  - this process's GPU buffers are capped at what a game can actually get:
+ *    RAM minus what the rest of the system needs (RAM / 8 clamped to
+ *    [768 MiB, 2 GiB] plus 2.5 GiB for the OS and the game's CPU side), at
+ *    least 4 GiB or half the RAM if less, at most 75% of the RAM (4.2 GiB on
+ *    8 GB, ~7.5 GiB on 12 GB, ~11 GiB on 16 GB). PanVK reports the same
+ *    figure as its heap size. PAN_MEM_LIMIT_MB overrides it, 0 disables the
+ *    guard;
+ *  - an allocation also fails while MemAvailable is below twice the critical
+ *    level and swap can't make room any more (less than 1/8 of it free, or
+ *    none): a game's CPU side normally gets swapped out when memory is low,
+ *    so low MemAvailable alone is no reason to refuse;
+ *  - if MemAvailable drops below the critical level (RAM / 24 clamped to
+ *    [256 MiB, 768 MiB]) while this process holds more than that in GPU
+ *    buffers, the process kills itself: its GPU memory is freed on exit and
+ *    nothing else is touched.
+ *
+ * Failed allocations return NULL (VK_ERROR_OUT_OF_DEVICE_MEMORY for the app).
+ * /proc/meminfo is read once per 64 MiB of new allocations, and on every
+ * allocation while memory is low.
+ */
+#define PAN_MEM_CHECK_STEP (64ull << 20)
+
+static struct {
+   once_flag once;
+   uint64_t limit;
+   uint64_t critical;
+   uint64_t held;
+   uint64_t unchecked;
+   uint32_t low;
+   uint32_t refusals;
+   /* Live accounted BOs by log2(size), for the diagnostic. */
+   uint32_t live[64];
+} pan_mem = { .once = ONCE_FLAG_INIT };
+
+uint64_t
+pan_kmod_mem_limit_for(uint64_t total)
+{
+   uint64_t other = CLAMP(total / 8, 768ull << 20, 2048ull << 20) +
+                    (2560ull << 20);
+   uint64_t size = total > other ? total - other : 0;
+
+   size = CLAMP(size, MIN2(4ull << 30, total / 2), total / 4 * 3);
+   return ROUND_DOWN_TO(size, 1 << 20);
+}
+
+static void
+pan_mem_init(void)
+{
+   int64_t mb = debug_get_num_option("PAN_MEM_LIMIT_MB", -1);
+   uint64_t total;
+
+   if (!os_get_total_physical_memory(&total))
+      return;
+
+   pan_mem.limit = mb >= 0 ? (uint64_t)mb << 20 : pan_kmod_mem_limit_for(total);
+   pan_mem.critical = CLAMP(total / 24, 256ull << 20, 768ull << 20);
+
+   mesa_logi("pan_kmod: GPU memory guard: limit %" PRIu64 " MiB, critical "
+             "level %" PRIu64 " MiB%s", pan_mem.limit >> 20,
+             pan_mem.critical >> 20, pan_mem.limit ? "" : " (disabled)");
+}
+
+uint64_t
+pan_kmod_mem_limit(void)
+{
+   call_once(&pan_mem.once, pan_mem_init);
+   return pan_mem.limit;
+}
+
+uint64_t
+pan_kmod_mem_held(void)
+{
+   return p_atomic_read(&pan_mem.held);
+}
+
+/* MemAvailable, SwapTotal and SwapFree in bytes. */
+static bool
+pan_mem_read_meminfo(uint64_t *avail, uint64_t *swap_total,
+                     uint64_t *swap_free)
+{
+   char *meminfo = os_read_file("/proc/meminfo", NULL);
+   if (!meminfo)
+      return false;
+
+   const char *keys[] = { "MemAvailable:", "SwapTotal:", "SwapFree:" };
+   uint64_t *vals[] = { avail, swap_total, swap_free };
+   bool ok = true;
+
+   for (unsigned i = 0; i < ARRAY_SIZE(keys); i++) {
+      const char *str = strstr(meminfo, keys[i]);
+      unsigned long long kb;
+
+      if (str && sscanf(str + strlen(keys[i]), "%llu", &kb) == 1)
+         *vals[i] = (uint64_t)kb << 10;
+      else
+         ok = false;
+   }
+
+   free(meminfo);
+   return ok;
+}
+
+static void
+pan_mem_log(const char *what, uint64_t size, uint32_t flags, uint64_t avail,
+            uint64_t swap_free)
+{
+   char sizes[512];
+   int n = 0;
+
+   sizes[0] = '\0';
+   for (unsigned i = 0; i < ARRAY_SIZE(pan_mem.live); i++) {
+      uint32_t count = p_atomic_read(&pan_mem.live[i]);
+      if (count && n < (int)sizeof(sizes))
+         n += snprintf(sizes + n, sizeof(sizes) - n, " %" PRIu64 "K:%u",
+                       (uint64_t)1 << i >> 10, count);
+   }
+
+   mesa_loge("pan_kmod: %s: request %" PRIu64 " KiB (flags 0x%x), "
+             "this process holds %" PRIu64 " MiB of GPU buffers (limit %"
+             PRIu64 " MiB), MemAvailable %" PRIu64 " MiB, SwapFree %" PRIu64
+             " MiB; live buffers by size class:%s",
+             what, size >> 10, flags, p_atomic_read(&pan_mem.held) >> 20,
+             pan_mem.limit >> 20, avail >> 20, swap_free >> 20, sizes);
+}
+
+static bool
+pan_mem_refuse(const char *what, uint64_t size, uint32_t flags)
+{
+   uint32_t refusals = p_atomic_inc_return(&pan_mem.refusals);
+   uint64_t avail = 0, swap_total = 0, swap_free = 0;
+
+   if (refusals == 1 || !(refusals & 255)) {
+      pan_mem_read_meminfo(&avail, &swap_total, &swap_free);
+      pan_mem_log(what, size, flags, avail, swap_free);
+   }
+   return false;
+}
+
+/* Returns false if the allocation must fail. */
+static bool
+pan_mem_admit(uint64_t size, uint32_t flags)
+{
+   if (!pan_kmod_mem_limit())
+      return true;
+
+   if (p_atomic_read(&pan_mem.held) + size > pan_mem.limit)
+      return pan_mem_refuse("GPU allocation refused: over this process's GPU "
+                            "memory limit", size, flags);
+
+   uint64_t pending = p_atomic_add_return(&pan_mem.unchecked, size);
+   if (!p_atomic_read(&pan_mem.low) && pending < PAN_MEM_CHECK_STEP)
+      return true;
+
+   p_atomic_set(&pan_mem.unchecked, 0);
+
+   uint64_t avail, swap_total, swap_free;
+   if (!pan_mem_read_meminfo(&avail, &swap_total, &swap_free))
+      return true;
+
+   if (avail < pan_mem.critical &&
+       p_atomic_read(&pan_mem.held) > pan_mem.critical) {
+      pan_mem_log("system memory critically low, killing this process to "
+                  "release its GPU memory", size, flags, avail, swap_free);
+      kill(getpid(), SIGKILL);
+   }
+
+   bool low = avail < 2 * pan_mem.critical + size;
+   p_atomic_set(&pan_mem.low, low);
+
+   if (low && swap_free <= swap_total / 8)
+      return pan_mem_refuse("GPU allocation refused: system memory low and "
+                            "swap full", size, flags);
+
+   return true;
+}
+
+static void
+pan_mem_account(struct pan_kmod_bo *bo, bool add)
+{
+   unsigned class = MIN2(util_logbase2_64(MAX2(bo->size, 1)),
+                         ARRAY_SIZE(pan_mem.live) - 1);
+
+   if (add) {
+      bo->mem_accounted = true;
+      p_atomic_add(&pan_mem.held, bo->size);
+      p_atomic_inc(&pan_mem.live[class]);
+   } else {
+      p_atomic_add(&pan_mem.held, -bo->size);
+      p_atomic_dec(&pan_mem.live[class]);
+   }
+}
+
 struct pan_kmod_bo *
 pan_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
                   uint64_t size, uint32_t flags)
 {
    struct pan_kmod_bo *bo;
 
+   if (!pan_mem_admit(size, flags))
+      return NULL;
+
    bo = dev->ops->bo_alloc(dev, exclusive_vm, size, flags);
    if (!bo)
       return NULL;
@@ -155,6 +368,7 @@ pan_kmod_bo_alloc(struct pan_kmod_dev *dev, struct pan_kmod_vm *exclusive_vm,
 
    assert(*slot == NULL);
    *slot = bo;
+   pan_mem_account(bo, true);
    return bo;
 }
 
@@ -184,6 +398,8 @@ pan_kmod_bo_put(struct pan_kmod_bo *bo)
 
       assert(slot);
       *slot = NULL;
+      if (bo->mem_accounted)
+         pan_mem_account(bo, false);
       bo->dev->ops->bo_free(bo);
    }
 
