+                                r * vs->fau.total_count * sizeof(uint64_t));
+      }
+
       cs_update_vt_ctx(b) {
          cs_move64_to(b, cs_sr_reg64(b, IDVS, VERTEX_FAU),
                       cmdbuf->state.gfx.vs.push_uniforms |
@@ -3036,7 +3166,8 @@ prepare_push_uniforms(struct panvk_cmd_buffer *cmdbuf,
       }
    }
 
-   if (fs_user_dirty(cmdbuf) || gfx_state_dirty(cmdbuf, FS_PUSH_UNIFORMS)) {
+   if (fs_user_dirty(cmdbuf) || gfx_state_dirty(cmdbuf, FS_PUSH_UNIFORMS) ||
+       fs_pushed_ubos) {
       uint64_t fau_ptr = 0;
 
       if (fs) {
@@ -3047,6 +3178,10 @@ prepare_push_uniforms(struct panvk_cmd_buffer *cmdbuf,
             return result;
          cmdbuf->state.gfx.fs.push_uniforms = push_uniforms.gpu;
 
+         if (fs_pushed_ubos)
+            copy_pushed_ubos(cmdbuf, &cmdbuf->state.gfx.fs.shader->desc_info,
+                             fs, push_uniforms.gpu);
+
          fau_ptr = cmdbuf->state.gfx.fs.push_uniforms |
                    ((uint64_t)fs->fau.total_count << 56);
       }
