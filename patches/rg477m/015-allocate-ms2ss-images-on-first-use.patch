+static simple_mtx_t ms_lock = SIMPLE_MTX_INITIALIZER;
+
+void
+panvk_image_ms_lock(void)
+{
+   simple_mtx_lock(&ms_lock);
+}
+
+void
+panvk_image_ms_unlock(void)
+{
+   simple_mtx_unlock(&ms_lock);
+}
+
+VkImage
+panvk_image_get_ms_img_locked(struct panvk_device *dev, struct panvk_image *img,
+                              uint32_t idx)
+{
+   simple_mtx_assert_locked(&ms_lock);
+
+   VkImage ms_img = img->ms_imgs[idx];
+   if (ms_img == VK_NULL_HANDLE || img->ms_mems[idx] != VK_NULL_HANDLE)
+      return ms_img;
+
+   VkDevice device = panvk_device_to_handle(dev);
+   VkImageMemoryRequirementsInfo2 reqs_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+      .image = ms_img,
+   };
+   VkMemoryRequirements2 reqs = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+   };
+   panvk_GetImageMemoryRequirements2(device, &reqs_info, &reqs);
+
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs.memoryRequirements.size,
+      .memoryTypeIndex = ffs(reqs.memoryRequirements.memoryTypeBits) - 1,
+   };
+   VkDeviceMemory mem;
+   if (panvk_AllocateMemory(device, &alloc_info, NULL, &mem) != VK_SUCCESS)
+      return VK_NULL_HANDLE;
+
+   const VkBindImageMemoryInfo bind_info = {
+      .sType = VK_STRUCTURE_TYPE_BIND_IMAGE_MEMORY_INFO,
+      .image = ms_img,
+      .memory = mem,
+   };
+   if (panvk_image_bind(dev, &bind_info) != VK_SUCCESS) {
+      panvk_FreeMemory(device, mem, NULL);
+      return VK_NULL_HANDLE;
+   }
+
+   img->ms_mems[idx] = mem;
+   return ms_img;
+}
+
