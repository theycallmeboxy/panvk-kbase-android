+++ b/src/vulkan/runtime/vk_graphics_state.c
@@ -2165,6 +2165,7 @@ vk_dynamic_graphics_state_fill(struct vk_dynamic_graphics_state *dyn,
       assert((dst)->state == (value));                      \
       BITSET_SET(dst->set, MESA_VK_DYNAMIC_##STATE);        \
       BITSET_SET(dst->dirty, MESA_VK_DYNAMIC_##STATE);      \
+      BITSET_SET(dst->written, MESA_VK_DYNAMIC_##STATE);    \
    }                                                        \
 } while(0)
 
@@ -2180,6 +2181,7 @@ vk_dynamic_graphics_state_fill(struct vk_dynamic_graphics_state *dyn,
       memcpy((dst)->state + start, src, __state_size);            \
       BITSET_SET(dst->set, MESA_VK_DYNAMIC_##STATE);              \
       BITSET_SET(dst->dirty, MESA_VK_DYNAMIC_##STATE);            \
+      BITSET_SET(dst->written, MESA_VK_DYNAMIC_##STATE);          \
    }                                                              \
 } while(0)
 
@@ -2411,6 +2413,7 @@ vk_dynamic_graphics_state_copy(struct vk_dynamic_graphics_state *dst,
        * the value from src.
        */
       dst->dirty[w] |= src->set[w] & ~dst->set[w];
+      dst->written[w] |= src->set[w] & ~dst->set[w];
 
       /* Everything that was in the source is now in the destination */
       dst->set[w] |= src->set[w];
@@ -2477,6 +2480,8 @@ vk_common_CmdSetVertexInputEXT(VkCommandBuffer commandBuffer,
    BITSET_SET(dyn->set, MESA_VK_DYNAMIC_VI_BINDING_STRIDES);
    BITSET_SET(dyn->dirty, MESA_VK_DYNAMIC_VI);
    BITSET_SET(dyn->dirty, MESA_VK_DYNAMIC_VI_BINDING_STRIDES);
+   BITSET_SET(dyn->written, MESA_VK_DYNAMIC_VI);
+   BITSET_SET(dyn->written, MESA_VK_DYNAMIC_VI_BINDING_STRIDES);
 }
 
 void
diff --git a/src/vulkan/runtime/vk_graphics_state.h b/src/vulkan/runtime/vk_graphics_state.h
index 1db6dd53..91d1a530 100644
--- a/src/vulkan/runtime/vk_graphics_state.h
+++ b/src/vulkan/runtime/vk_graphics_state.h
@@ -987,6 +987,15 @@ struct vk_dynamic_graphics_state {
 
    /** For command buffers, which bits of dynamic state have changed */
    BITSET_DECLARE(dirty, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX);
+
+   /** For command buffers, which bits of dynamic state have changed value
+    *
+    * Set wherever dirty is set for a value change, but never cleared by the
+    * runtime: the driver clears it when it wants to know which state was
+    * written after some point, for instance whether a rebind of the pipeline
+    * last bound would change anything.
+    */
+   BITSET_DECLARE(written, MESA_VK_DYNAMIC_GRAPHICS_STATE_ENUM_MAX);
 };
 
 /***/
diff --git a/src/vulkan/runtime/vk_pipeline.c b/src/vulkan/runtime/vk_pipeline.c
index d134e226..320e259b 100644
--- a/src/vulkan/runtime/vk_pipeline.c
+++ b/src/vulkan/runtime/vk_pipeline.c
@@ -2013,6 +2013,19 @@ static const struct vk_pipeline_ops vk_graphics_pipeline_ops = {
    .get_shader = vk_graphics_pipeline_get_shader,
 };
 
+const struct vk_dynamic_graphics_state *
+vk_graphics_pipeline_get_bind_state(const struct vk_pipeline *pipeline)
+{
+   if (pipeline->ops != &vk_graphics_pipeline_ops ||
+       (pipeline->flags & VK_PIPELINE_CREATE_2_LIBRARY_BIT_KHR))
+      return NULL;
+
+   const struct vk_graphics_pipeline *gfx_pipeline =
+      container_of(pipeline, struct vk_graphics_pipeline, base);
+
+   return &gfx_pipeline->linked.dynamic;
+}
+
 static VkResult
 vk_create_graphics_pipeline(struct vk_device *device,
                             struct vk_pipeline_cache *cache,
