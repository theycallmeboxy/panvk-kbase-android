+ *  - store STORE or NONE: the result must be the loaded contents, which is
+ *    what memory holds already. Not writing it back leaves every byte of the
+ *    plane, and any AFBC header of it, as it was. (Z/S planes have no CRC.)
+ * The incremental-rendering spills of that aspect are dropped with it: the
+ * memory copy stays valid through the IR passes, nothing in the tile buffer
+ * needs preserving.
+ *
+ * "Reads or writes" is kept conservative, from the state each draw (API or
+ * vk_meta, vkCmdClearAttachments included) is recorded with: depth: the depth
+ * test (depth writes need it) or the depth bounds test enabled, a bound
+ * fragment shader reading depth (input attachment, tile read) or
+ * rasterization-order depth access; stencil likewise with the stencil test.
+ * A vkCmdClearAttachments of the aspect and any vkCmdExecuteCommands in the
+ * pass count as touching it.
+ *
+ * Candidates are decided at CmdBeginRendering: separate (planar) Z/S only,
+ * no CLEAR load op (the store writes the clear), no resolve and no
+ * multisampled-render-to-single-sampled (both read the aspect or another
+ * image), no multiview, no suspend/resume (draws elsewhere), not a secondary
+ * continuing a render pass. Only v11/v12: v10 bakes FBD words into the CRC
+ * patch commands, and v13+ (HSR prepass) and v14 (layer state) aren't covered.
+ *
+ * Whether the pass touches an aspect is only known at CmdEndRendering, but
+ * the FBDs are emitted at its first draw. They are emitted with the
+ * candidates nothing has touched yet dropped (zs_untouched_skip_speculate()),
+ * which is the final answer for most passes. If a later draw touches a
+ * dropped aspect, CmdEndRendering puts its load/store back and writes the
+ * descriptors again in place (emit_fb_desc_sets()): the command stream only
+ * refers to them by address, and the tag, size and layout don't depend on
+ * the Z/S load/store (has_zs_crc_ext follows the formats). Nothing else
+ * recorded during the pass reads the Z/S load/store state.
+ *
+ * PANVK_NO_ZS_UNTOUCHED_SKIP=1 restores the old behaviour. */
+#define PANVK_ZS_SKIP_ARCH (PAN_ARCH == 11 || PAN_ARCH == 12)
+
+#if PANVK_ZS_SKIP_ARCH
+static bool
+zs_untouched_skip_enabled(void)
+{
+   static int disabled = -1;
+
+   if (disabled < 0)
+      disabled = debug_get_bool_option("PANVK_NO_ZS_UNTOUCHED_SKIP", false);
+
+   return !disabled;
+}
+
+static bool
+zs_untouched_skip_aspect_ok(const struct panvk_cmd_buffer *cmdbuf,
+                            const VkRenderingAttachmentInfo *att,
+                            const struct panvk_image_view *preload_iview,
+                            const struct pan_fb_load_target *load,
+                            const struct pan_fb_store_target *store)
+{
+   if (!att || att->imageView == VK_NULL_HANDLE)
+      return false;
+
+   VK_FROM_HANDLE(panvk_image_view, iview, att->imageView);
+   const struct panvk_image *img =
+      container_of(iview->vk.image, struct panvk_image, vk);
+
+   /* Interleaved Z/S share one store; ms2ss loads and stores go through
+    * another image; resolves read the aspect. */
+   if (panvk_image_is_interleaved_depth_stencil(img) || preload_iview ||
+       att->resolveMode != VK_RESOLVE_MODE_NONE)
+      return false;
+
+   /* A cleared aspect is written by its load op. */
+   if (att->loadOp == VK_ATTACHMENT_LOAD_OP_CLEAR || pan_target_has_clear(load))
+      return false;
+
+   if (store->store && store->always)
+      return false;
+
+   /* Only aspects with something to drop. */
+   const bool border_load =
+      load->border_load == PAN_FB_LOAD_IMAGE &&
+      pan_fb_has_partial_tiles(&cmdbuf->state.gfx.render.fb.layout);
+
+   return load->in_bounds_load == PAN_FB_LOAD_IMAGE || border_load ||
+          store->store;
+}
+
+/* Drops (restore = false) or puts back (restore = true) the load, store and
+ * IR spills of aspects. */
+static void
+zs_untouched_skip_set(struct panvk_rendering_state *render, uint8_t aspects,
+                      bool restore)
+{
+   for (unsigned a = 0; a < 2; a++) {
+      const uint8_t bit =
+         a ? VK_IMAGE_ASPECT_STENCIL_BIT : VK_IMAGE_ASPECT_DEPTH_BIT;
+      struct pan_fb_load_target *load = a ? &render->fb.load.s
+                                          : &render->fb.load.z;
+      struct pan_fb_load_target *spill_load = a ? &render->fb.spill.load.s
+                                                : &render->fb.spill.load.z;
+      struct pan_fb_store_target *store = a ? &render->fb.store.s
+                                            : &render->fb.store.zs;
+      struct pan_fb_store_target *spill_store = a ? &render->fb.spill.store.s
+                                                  : &render->fb.spill.store.zs;
+
+      if (!(aspects & bit))
+         continue;
+
+      if (restore) {
+         assert(render->zs_skip.dropped & bit);
+         *load = render->zs_skip.saved[a].load;
+         *spill_load = render->zs_skip.saved[a].spill_load;
+         *store = render->zs_skip.saved[a].store;
+         *spill_store = render->zs_skip.saved[a].spill_store;
+         render->zs_skip.dropped &= ~bit;
+      } else {
+         assert(!(render->zs_skip.dropped & bit));
+         render->zs_skip.saved[a].load = *load;
+         render->zs_skip.saved[a].spill_load = *spill_load;
+         render->zs_skip.saved[a].store = *store;
+         render->zs_skip.saved[a].spill_store = *spill_store;
+         *load = (struct pan_fb_load_target){0};
+         *spill_load = (struct pan_fb_load_target){0};
+         *store = (struct pan_fb_store_target){0};
+         *spill_store = (struct pan_fb_store_target){0};
+         render->zs_skip.dropped |= bit;
+      }
+   }
+}
+#endif
+
+static void
+zs_untouched_skip_begin(struct panvk_cmd_buffer *cmdbuf,
+                        const VkRenderingInfo *info)
+{
+   struct panvk_rendering_state *render = &cmdbuf->state.gfx.render;
+
+   render->zs_skip.candidates = 0;
+   render->zs_skip.touched = 0;
+   render->zs_skip.dropped = 0;
+
+#if PANVK_ZS_SKIP_ARCH
+   if (!zs_untouched_skip_enabled() || inherits_render_ctx(cmdbuf) ||
+       info->viewMask ||
+       (info->flags &
+        (VK_RENDERING_SUSPENDING_BIT | VK_RENDERING_RESUMING_BIT)))
+      return;
+
+   if (zs_untouched_skip_aspect_ok(cmdbuf, info->pDepthAttachment,
+                                   render->z_attachment.preload_iview,
+                                   &render->fb.load.z, &render->fb.store.zs))
+      render->zs_skip.candidates |= VK_IMAGE_ASPECT_DEPTH_BIT;
+
+   if (zs_untouched_skip_aspect_ok(cmdbuf, info->pStencilAttachment,
+                                   render->s_attachment.preload_iview,
+                                   &render->fb.load.s, &render->fb.store.s))
+      render->zs_skip.candidates |= VK_IMAGE_ASPECT_STENCIL_BIT;
+#else
+   (void)info;
+#endif
+}
+
+/* Marks the aspects the current draw state may read or write. Called for
+ * every draw recorded in the pass, API and vk_meta, before anything of it is
+ * recorded (so before the first draw emits the FBDs). */
+static inline void
+zs_untouched_skip_track(struct panvk_cmd_buffer *cmdbuf)
+{
+   struct panvk_rendering_state *render = &cmdbuf->state.gfx.render;
+
+   if (likely(!(render->zs_skip.candidates & ~render->zs_skip.touched)))
+      return;
+
+   const struct vk_dynamic_graphics_state *dyns =
+      &cmdbuf->vk.dynamic_graphics_state;
+   const struct panvk_shader_variant *fs =
+      panvk_shader_only_variant(cmdbuf->state.gfx.fs.shader);
+   uint8_t touched = 0;
+
+   if (dyns->ds.depth.test_enable || dyns->ds.depth.bounds_test.enable ||
+       (dyns->rasterization_order_access & VK_IMAGE_ASPECT_DEPTH_BIT) ||
+       (fs && z_attachment_read(fs, &dyns->ial)))
+      touched |= VK_IMAGE_ASPECT_DEPTH_BIT;
+
+   if (dyns->ds.stencil.test_enable ||
+       (dyns->rasterization_order_access & VK_IMAGE_ASPECT_STENCIL_BIT) ||
+       (fs && s_attachment_read(fs, &dyns->ial)))
+      touched |= VK_IMAGE_ASPECT_STENCIL_BIT;
+
+   render->zs_skip.touched |= touched;
+}
+
+/* get_fb_descs(), before the first emission: drop the candidates nothing
+ * has touched so far. */
+static inline void
+zs_untouched_skip_speculate(struct panvk_cmd_buffer *cmdbuf)
+{
+#if PANVK_ZS_SKIP_ARCH
+   struct panvk_rendering_state *render = &cmdbuf->state.gfx.render;
+   const uint8_t drop = render->zs_skip.candidates & ~render->zs_skip.touched &
+                        ~render->zs_skip.dropped;
+
+   if (unlikely(drop) && !inherits_render_ctx(cmdbuf))
+      zs_untouched_skip_set(render, drop, false);
+#endif
+}
+
+/* At CmdEndRendering of a pass that isn't suspending, before its fragment
+ * job is issued: settle the dropped aspects on the untouched candidates. */
+static VkResult
+zs_untouched_skip_end(struct panvk_cmd_buffer *cmdbuf)
+{
+#if PANVK_ZS_SKIP_ARCH
+   struct panvk_rendering_state *render = &cmdbuf->state.gfx.render;
+   const uint8_t final = inherits_render_ctx(cmdbuf)
+                            ? 0
+                            : render->zs_skip.candidates &
+                                 ~render->zs_skip.touched;
+   const uint8_t restore = render->zs_skip.dropped & ~final;
+   const uint8_t drop = final & ~render->zs_skip.dropped;
+
+   render->zs_skip.candidates = 0;
+
+   if (likely(!restore && !drop))
+      return VK_SUCCESS;
+
+   zs_untouched_skip_set(render, restore, true);
+   zs_untouched_skip_set(render, drop, false);
+
+   /* No descriptors yet (no draw): CmdEndRendering emits them from this
+    * state if the pass clears something, else the pass issues nothing. */
+   if (!render->fbds.gpu)
+      return VK_SUCCESS;
+
+   uint32_t fbd_flags;
+   VkResult result = emit_fb_desc_sets(cmdbuf, &fbd_flags);
+   if (result != VK_SUCCESS)
+      return result;
+
+   /* The FBD pointer tag is already in the command stream. */
+   assert(fbd_flags == render->fbd_emit.fbd_flags);
+#endif
+
+   return VK_SUCCESS;
+}
