+
 static inline struct pan_kmod_bo *
 pan_kmod_bo_get(struct pan_kmod_bo *bo)
 {
diff --git a/src/panfrost/vulkan/panvk_physical_device.c b/src/panfrost/vulkan/panvk_physical_device.c
index 6369027..6f32f77 100644
--- a/src/panfrost/vulkan/panvk_physical_device.c
+++ b/src/panfrost/vulkan/panvk_physical_device.c
@@ -505,6 +505,28 @@ get_core_masks(struct panvk_physical_device *device,
    return result;
 }
 
+static uint64_t
+panvk_heap_size(struct panvk_instance *instance)
+{
+   float *percent = &instance->drirc.misc.heap_memory_percent;
+   uint64_t total;
+
+   if (*percent != OS_GPU_HEAP_SIZE_HEURISTIC ||
+       !os_get_total_physical_memory(&total))
+      return os_get_gpu_heap_size(*percent, percent);
+
+   /* The GPU shares RAM with everything else, and engines size their pools
+    * from the heap size as if it were dedicated VRAM: report what a game can
+    * actually get, the GPU memory guard's limit (see pan_kmod.c).
+    */
+   uint64_t size = pan_kmod_mem_limit();
+   if (!size)
+      size = pan_kmod_mem_limit_for(total);
+
+   *percent = (float)size / total;
+   return size;
+}
+
 static VkResult
 get_device_heaps(struct panvk_physical_device *device,
                  struct panvk_instance *instance)
@@ -512,9 +534,7 @@ get_device_heaps(struct panvk_physical_device *device,
    int host_coherent_not_cached_idx = -1;
    int host_cached_not_coherent_idx = -1;
 
-   const uint64_t heap_size =
-      os_get_gpu_heap_size(instance->drirc.misc.heap_memory_percent,
-                           &instance->drirc.misc.heap_memory_percent);
+   const uint64_t heap_size = panvk_heap_size(instance);
 
    device->memory.heap_count = 1;
    device->memory.heaps[0] = (VkMemoryHeap){
@@ -1758,10 +1778,22 @@ panvk_GetPhysicalDeviceMemoryProperties2(
           */
          p->heapUsage[0] = used;
 
-         /* Set the budget at 90% of available to avoid thrashing */
-         p->heapBudget[0] = vk_physical_device_heap_budget(
-            panvk_available_system_memory(physical_device), 0.9f, heap_size,
-            used);
+         /* With the GPU memory guard, budget what this process may still
+          * allocate under its limit (allocations past it fail); otherwise 90%
+          * of what is available. Never 0, as the spec requires.
+          */
+         uint64_t limit = pan_kmod_mem_limit();
+         if (limit) {
+            uint64_t held = pan_kmod_mem_held();
+            uint64_t room = limit > held ? limit - held : 0;
+            p->heapBudget[0] =
+               MAX2(ROUND_DOWN_TO(MIN2(heap_size, used + room), 1 << 20),
+                    1ull << 20);
+         } else {
+            p->heapBudget[0] = vk_physical_device_heap_budget(
+               panvk_available_system_memory(physical_device), 0.9f,
+               heap_size, used);
+         }
 
