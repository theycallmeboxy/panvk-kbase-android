+/* The gpu_prerast arenas are fully committed when allocated: on MediaTek
+ * kbase (CSF 1.21), GPU-fault growth loses the first gpu_prerast draw's
+ * output (PanProbe gs_viewport_depth case A drew nothing on every run;
+ * without alloc-on-fault, 6/6 runs pass). They are allocated on the first
+ * draw that needs them (panvk_per_arch(gpu_prerast_get_arena)), not at
+ * device creation: 160 MiB per VkDevice otherwise, and DXVK enables the
+ * features on every device. */
 static struct panvk_priv_mem
 alloc_gpu_prerast_arena(struct panvk_device *dev, uint64_t size)
 {
@@ -150,6 +151,35 @@ alloc_gpu_prerast_arena(struct panvk_device *dev, uint64_t size)
 
    return (struct panvk_priv_mem){.bo = (uintptr_t)bo};
 }
+
+uint64_t
+panvk_per_arch(gpu_prerast_get_arena)(struct panvk_device *dev, bool tess)
+{
+   struct panvk_priv_mem *mem =
+      tess ? &dev->gpu_prerast_tess_arena : &dev->gpu_prerast_arena;
+   const bool enabled =
+      tess ? dev->gpu_prerast_tess_enabled : dev->gpu_prerast_enabled;
+
+   if (!enabled)
+      return 0;
+
+   simple_mtx_lock(&dev->gpu_prerast_lock);
+   if (!panvk_priv_mem_check_alloc(*mem)) {
+      struct panvk_priv_mem arena_mem = alloc_gpu_prerast_arena(
+         dev, tess ? PANVK_GPU_PRERAST_TESS_ARENA_SIZE
+                   : PANVK_GPU_PRERAST_ARENA_SIZE);
+      if (panvk_priv_mem_check_alloc(arena_mem)) {
+         panvk_priv_mem_write(arena_mem, 0, struct panvk_gpu_prerast_arena,
+                              arena) {
+            memset(arena, 0, sizeof(*arena));
+         }
+         *mem = arena_mem;
+      }
+   }
+   simple_mtx_unlock(&dev->gpu_prerast_lock);
+
+   return panvk_priv_mem_check_alloc(*mem) ? panvk_priv_mem_dev_addr(*mem) : 0;
+}
 #endif
 
