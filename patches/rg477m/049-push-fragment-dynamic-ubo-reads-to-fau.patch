+static bool
+has_pushed_ubos(const struct panvk_shader_variant *shader)
+{
+   const struct pan_fau_layout *fau = &shader->info.fau;
+
+   pan_fau_foreach_reloc(fau, i)
+      return true;
+
+   return false;
+}
+
+/* Copies the UBO words the compiler moved to the FAU (the relocations of the
+ * shader's pan_fau_layout, see panvk_set_pushable_ubos()) from the bound
+ * dynamic uniform buffers into the FAU at fau_gpu. The copy runs in the
+ * command stream right before the draw, so the words are read when the draw
+ * executes, like the UBO loads they replace. Words past the end of the bound
+ * range read as zero, like robust UBO loads. The caller allocates a new FAU
+ * buffer for every draw that has such words: earlier draws' fragment jobs may
+ * still read theirs. */
+static void
+copy_pushed_ubos(struct panvk_cmd_buffer *cmdbuf,
+                 const struct panvk_shader_desc_info *desc_info,
+                 const struct panvk_shader_variant *shader, uint64_t fau_gpu)
+{
+   struct cs_builder *b =
+      panvk_get_cs_builder(cmdbuf, PANVK_SUBQUEUE_VERTEX_TILER);
+   const struct panvk_descriptor_state *desc_state =
+      &cmdbuf->state.gfx.desc_state;
+   const struct pan_fau_layout *fau = &shader->info.fau;
+   struct cs_index src = cs_scratch_reg64(b, 0);
+   struct cs_index dst = cs_scratch_reg64(b, 2);
+   /* Data registers: the loads of up to PUSH_COPY_REGS words are issued
+    * before the first store waits for them, so a batch costs one memory
+    * round trip instead of one per run. Scratch registers 4 to 17 (v11 has
+    * 18 scratch registers). */
+#define PUSH_COPY_REGS 14
+   struct {
+      uint16_t fau_word, reg, count;
+   } pending[PUSH_COPY_REGS];
+   unsigned npending = 0, nregs = 0;
+
+   cs_move64_to(b, dst, fau_gpu);
+
+   for (unsigned i = fau->reserved; i <= fau->count;) {
+      unsigned n = 0;
+      struct pan_ubo_relocation reloc = {0};
+
+      if (i < fau->count && !BITSET_TEST(fau->is_const, i)) {
+         reloc = fau->words[i].relocation;
+         /* A run of words that are consecutive in both the FAU and the UBO. */
+         n = 1;
+         while (i + n < fau->count && n < PUSH_COPY_REGS &&
+                !BITSET_TEST(fau->is_const, i + n) &&
+                fau->words[i + n].relocation.ubo == reloc.ubo &&
+                fau->words[i + n].relocation.offset == reloc.offset + 4 * n)
+            n++;
+      }
+
+      /* Store the batch when it is full or at the end. */
+      if (npending && (i == fau->count || nregs + n > PUSH_COPY_REGS)) {
+         for (unsigned p = 0; p < npending; p++)
+            cs_store(b, cs_scratch_reg_tuple(b, 4 + pending[p].reg,
+                                             pending[p].count),
+                     dst, BITFIELD_MASK(pending[p].count),
+                     pending[p].fau_word * 4);
+         npending = nregs = 0;
+      }
+
+      if (i == fau->count)
+         break;
+
+      if (!n) {
+         i++;
+         continue;
+      }
+
+      uint64_t addr = 0;
+      uint32_t size = 0;
+      const uint32_t idx = reloc.ubo - desc_info->dyn_bufs_start;
+
+      if (reloc.ubo >= desc_info->dyn_bufs_start &&
+          idx < desc_info->dyn_bufs.count) {
+         const uint32_t src_handle = desc_info->dyn_bufs.map[idx];
+         const uint32_t set_idx = COPY_DESC_HANDLE_EXTRACT_TABLE(src_handle);
+         const uint32_t dyn_buf_idx =
+            COPY_DESC_HANDLE_EXTRACT_INDEX(src_handle);
+         const struct panvk_descriptor_set *set = desc_state->sets[set_idx];
+
+         if (set &&
+             !(desc_state->dyn_ssbos[set_idx] & BITFIELD_BIT(dyn_buf_idx))) {
+            addr = set->dyn_bufs[dyn_buf_idx].dev_addr +
+                   desc_state->dyn_buf_offsets[set_idx][dyn_buf_idx];
+            size = set->dyn_bufs[dyn_buf_idx].size;
+         }
+      }
+
+      const unsigned in_bounds =
+         addr && reloc.offset < size ? MIN2(n, (size - reloc.offset) / 4) : 0;
+      struct cs_index data = cs_scratch_reg_tuple(b, 4 + nregs, n);
+
+      if (in_bounds) {
+         cs_move64_to(b, src, addr + reloc.offset);
+         cs_load_to(b, data, src, BITFIELD_MASK(in_bounds), 0);
+      }
+      for (unsigned w = in_bounds; w < n; w++)
+         cs_move32_to(b, cs_extract32(b, data, w), 0);
+
+      pending[npending].fau_word = i;
+      pending[npending].reg = nregs;
+      pending[npending].count = n;
+      npending++;
+      nregs += n;
+      i += n;
+   }
+#undef PUSH_COPY_REGS
+
+   /* The draw's shaders read the FAU from memory. */
+   cs_flush_stores(b);
+}
