---
 src/panfrost/vulkan/panvk_cmd_draw.h    | 18 ++++++++++++++++++
 src/panfrost/vulkan/panvk_vX_blend.c    | 15 ++++++++++++++-
 src/panfrost/vulkan/panvk_vX_cmd_draw.c | 23 +++++++++++++++++++----
 3 files changed, 51 insertions(+), 5 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index 40f57acb..b6c44695 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -22,6 +22,7 @@
 #include "vk_command_buffer.h"
 #include "vk_format.h"
 #include "vk_meta.h"
+#include "util/u_debug.h"
 #include "util/u_tristate.h"
 
 #include "pan_fb.h"
@@ -195,6 +196,9 @@ struct panvk_cmd_graphics_state {
       const struct panvk_shader *shader;
       struct panvk_shader_desc_state desc;
       uint64_t blend_descs[MAX_RTS];
+      /* blend_descs[] was rewritten since cmd_prepare_draw_sysvals() last
+       * copied it into the sysvals. */
+      bool blend_descs_changed;
       uint64_t push_uniforms;
       bool required;
 #if PAN_ARCH < 9
@@ -304,6 +308,20 @@ panvk_prerast_viewport_shader(const struct panvk_cmd_graphics_state *gfx)
 }
 #endif
 
+/* cmd_prepare_draw_sysvals() and blend_emit_descs() skip sysval compares and
+ * FS push uniform uploads whose inputs no dirty state says changed.
+ * PANVK_NO_SYSVAL_GATE=1 does all of them on every draw again. */
+static inline bool
+panvk_sysval_gate_enabled(void)
+{
+   static int disabled = -1;
+
+   if (disabled < 0)
+      disabled = debug_get_bool_option("PANVK_NO_SYSVAL_GATE", false);
+
+   return !disabled;
+}
+
 #define dyn_gfx_state_dirty(__cmdbuf, __name)                                  \
    BITSET_TEST((__cmdbuf)->vk.dynamic_graphics_state.dirty,                    \
                MESA_VK_DYNAMIC_##__name)
diff --git a/src/panfrost/vulkan/panvk_vX_blend.c b/src/panfrost/vulkan/panvk_vX_blend.c
index 25ae0212..28112ff3 100644
--- a/src/panfrost/vulkan/panvk_vX_blend.c
+++ b/src/panfrost/vulkan/panvk_vX_blend.c
@@ -321,6 +321,8 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
    memset(loc_rt, MESA_VK_ATTACHMENT_UNUSED, sizeof(loc_rt));
    memset(rt_loc, MESA_VK_ATTACHMENT_UNUSED, sizeof(rt_loc));
 
+   const struct panvk_blend_info prev_blend_info = *blend_info;
+
    memset(blend_info, 0, sizeof(*blend_info));
    for (uint8_t i = 0; i < bs.rt_count; i++) {
       struct pan_blend_rt_state *rt = &bs.rts[i];
@@ -461,7 +463,18 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
       }
    }
 
-   gfx_state_set_dirty(cmdbuf, FS_PUSH_UNIFORMS);
+   cmdbuf->state.gfx.fs.blend_descs_changed = true;
+
+   /* cmd_prepare_draw_sysvals() flags the FS push uniforms when the
+    * descriptors or the constants it reads change. Whether the FS reads the
+    * blend constants at all changes with the blend shaders: re-upload then,
+    * the constants were not tracked while unused.
+    */
+   if (!panvk_sysval_gate_enabled() ||
+       prev_blend_info.needs_shader != blend_info->needs_shader ||
+       prev_blend_info.shader_loads_blend_const !=
+          blend_info->shader_loads_blend_const)
+      gfx_state_set_dirty(cmdbuf, FS_PUSH_UNIFORMS);
 
    return VK_SUCCESS;
 }
diff --git a/src/panfrost/vulkan/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/panvk_vX_cmd_draw.c
index d66153ec..0b6487c1 100644
--- a/src/panfrost/vulkan/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_draw.c
@@ -971,9 +971,15 @@ panvk_per_arch(cmd_prepare_draw_sysvals)(struct panvk_cmd_buffer *cmdbuf,
       }
    }
 
-   for (unsigned i = 0; i < MAX_RTS; i++) {
-      set_gfx_sysval(cmdbuf, dirty_sysvals, fs.blend_descs[i],
-                     cmdbuf->state.gfx.fs.blend_descs[i]);
+   const bool gate = panvk_sysval_gate_enabled();
+
+   /* Only blend_emit_descs() writes fs.blend_descs[], and it flags it. */
+   if (!gate || cmdbuf->state.gfx.fs.blend_descs_changed) {
+      for (unsigned i = 0; i < MAX_RTS; i++) {
+         set_gfx_sysval(cmdbuf, dirty_sysvals, fs.blend_descs[i],
+                        cmdbuf->state.gfx.fs.blend_descs[i]);
+      }
+      cmdbuf->state.gfx.fs.blend_descs_changed = false;
    }
 
    if (dyn_gfx_state_dirty(cmdbuf, VP_VIEWPORTS) ||
@@ -1025,7 +1031,12 @@ panvk_per_arch(cmd_prepare_draw_sysvals)(struct panvk_cmd_buffer *cmdbuf,
 #endif
 
 #if PAN_ARCH >= 9
-   {
+   /* The attachments change only with RENDER_STATE, which meta restore and
+    * the state resets also set. */
+   if (!gate || dyn_gfx_state_dirty(cmdbuf, DS_DEPTH_BOUNDS_TEST_ENABLE) ||
+       dyn_gfx_state_dirty(cmdbuf, DS_DEPTH_BOUNDS_TEST_BOUNDS) ||
+       dyn_gfx_state_dirty(cmdbuf, MS_RASTERIZATION_SAMPLES) ||
+       gfx_state_dirty(cmdbuf, RENDER_STATE)) {
       const struct vk_depth_stencil_state *dss =
          &cmdbuf->vk.dynamic_graphics_state.ds;
       const bool db_enable =
@@ -1080,6 +1091,10 @@ panvk_per_arch(cmd_prepare_draw_sysvals)(struct panvk_cmd_buffer *cmdbuf,
    }
 #endif
 
+   /* Nothing changed: the masks below would all come out empty. */
+   if (BITSET_IS_EMPTY(dirty_sysvals))
+      return;
+
    /* We mask the dirty sysvals by the shader usage, and only flag
     * the push uniforms dirty if those intersect. */
    BITSET_DECLARE(dirty_shader_sysvals, MAX_SYSVAL_FAUS);
