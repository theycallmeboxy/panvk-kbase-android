+emit_subqueue_wait(struct cs_builder *b, struct panvk_cmd_buffer *cmdbuf,
+                   enum panvk_subqueue_id i, enum panvk_subqueue_id j,
+                   int32_t sync_point, struct cs_index tmp_regs)
