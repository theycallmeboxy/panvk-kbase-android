+/*
+ * Copyright 2026 theycallmeboxy
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "valhall/valhall.h"
+#include "bi_builder.h"
+#include "compiler.h"
+
+/*
+ * Valhall has no "flush FP16 denormals, preserve FP32 denormals" FTZ mode.
+ * Shaders that ask for it run in the "preserve subnormals" mode, and this pass
+ * gives FP16 the behaviour of the "always" mode with FLUSH.v2f16.ftz:
+ *
+ * - Every FP16 result of float arithmetic is flushed, as DenormFlushToZero
+ *   requires for OpFAdd, OpFMul, OpFNegate, FAbs, FMin, OpFConvert etc.
+ *
+ * - Every FP16 operand of a float operation is flushed unless it already was
+ *   (it comes from one of the results above, or cannot be a denormal).
+ *   Operands "may" be flushed, so this is valid, and it is needed: NIR drops
+ *   an fcanonicalize (from e.g. fmul(a, 1.0)) whose users are float
+ *   operations, on the grounds that they flush their operands, as the
+ *   hardware FTZ modes do.
+ *
+ * Bit-preserving operations (moves, selects, phis, stores, bitcasts) are left
+ * alone, as they must not flush. Cooperative matrix MMUL is not covered by
+ * the float controls rules and is left alone too.
+ *
+ * Runs on SSA, before the optimisation passes, so that modifier propagation
+ * sees the flushes.
+ */
+
+/* FP16 float results to flush */
+static bool
+writes_fp16_float(const bi_instr *I)
+{
+   switch (I->op) {
+   case BI_OPCODE_FADD_V2F16:
+   case BI_OPCODE_FADD_IMM_V2F16:
+   case BI_OPCODE_FMA_V2F16:
+   case BI_OPCODE_FMA_RSCALE_V2F16:
+   case BI_OPCODE_FMIN_V2F16:
+   case BI_OPCODE_FMAX_V2F16:
+   case BI_OPCODE_FABSNEG_V2F16:
+   case BI_OPCODE_FCLAMP_V2F16:
+   case BI_OPCODE_FRCP_F16:
+   case BI_OPCODE_FRSQ_F16:
+   case BI_OPCODE_LDEXP_V2F16:
+   case BI_OPCODE_V2F32_TO_V2F16:
+      return true;
+   default:
+      /* FP32 arithmetic written to one half converts to FP16 */
+      return va_op_dest_modifier_does_convert(I->op) &&
+             I->dest[0].swizzle != BI_SWIZZLE_H01;
+   }
+}
+
+/* Producers whose FP16 result is never a denormal */
+static bool
+writes_fp16_canonical(const bi_instr *I)
+{
+   switch (I->op) {
+   case BI_OPCODE_FLUSH_V2F16:
+      return I->ftz;
+   case BI_OPCODE_FROUND_V2F16:   /* integral */
+   case BI_OPCODE_FREXPM_V2F16:   /* mantissa, 0.5 <= |m| < 1 */
+   case BI_OPCODE_V2S16_TO_V2F16: /* integers */
+   case BI_OPCODE_V2U16_TO_V2F16:
+   case BI_OPCODE_V2S8_TO_V2F16:
+   case BI_OPCODE_V2U8_TO_V2F16:
+      return true;
+   default:
+      return false;
+   }
+}
+
+/* FP16 float operands, as a source mask */
+static unsigned
+reads_fp16_float(const bi_instr *I)
+{
+   switch (I->op) {
+   case BI_OPCODE_FMA_V2F16:
+   case BI_OPCODE_FMA_RSCALE_V2F16: /* src3 is the integer scale */
+      return BITFIELD_MASK(3);
+   case BI_OPCODE_FADD_V2F16:
+   case BI_OPCODE_FMIN_V2F16:
+   case BI_OPCODE_FMAX_V2F16:
+   case BI_OPCODE_FCMP_V2F16:
+   case BI_OPCODE_CSEL_V2F16:       /* src2/3 are selected, not compared */
+      return BITFIELD_MASK(2);
+   case BI_OPCODE_FADD_IMM_V2F16:
+   case BI_OPCODE_FABSNEG_V2F16:
+   case BI_OPCODE_FCLAMP_V2F16:
+   case BI_OPCODE_FRCP_F16:
+   case BI_OPCODE_FRSQ_F16:
+   case BI_OPCODE_LDEXP_V2F16:      /* src1 is the integer exponent */
+   case BI_OPCODE_FROUND_V2F16:
+   case BI_OPCODE_FREXPM_V2F16:
+   case BI_OPCODE_FREXPE_V2F16:
+   case BI_OPCODE_F16_TO_F32:
+      return BITFIELD_BIT(0);
+   default:
+      return 0;
+   }
+}
+
+static uint32_t
+flush_fp16_denorms_u32(uint32_t v)
+{
+   for (unsigned h = 0; h < 2; ++h) {
+      uint32_t half = (v >> (16 * h)) & 0xffff;
+
+      /* Exponent zero, mantissa non-zero: keep the sign only */
+      if (!(half & 0x7c00) && (half & 0x03ff))
+         v &= ~(0x7fffu << (16 * h));
+   }
+
+   return v;
+}
+
+void
+bi_emulate_ftz_fp16(bi_context *ctx)
+{
+   /* Producer of every SSA value as emitted, before we add anything */
+   bi_instr **lut = rzalloc_array(ctx, bi_instr *, ctx->ssa_alloc);
+
+   bi_foreach_instr_global(ctx, I) {
+      bi_foreach_dest(I, d) {
+         if (bi_is_ssa(I->dest[d]))
+            lut[I->dest[d].value] = I;
+      }
+   }
+
+   unsigned nr_values = ctx->ssa_alloc;
+
+   bi_foreach_instr_global_safe(ctx, I) {
+      unsigned operands = reads_fp16_float(I);
+
+      u_foreach_bit(s, operands) {
+         bi_index src = I->src[s];
+
+         if (src.type == BI_INDEX_CONSTANT) {
+            /* Covers both halves whatever the swizzle */
+            I->src[s].value = flush_fp16_denorms_u32(src.value);
+            continue;
+         }
+
+         if (src.type != BI_INDEX_NORMAL && src.type != BI_INDEX_FAU)
+            continue;
+
+         if (bi_is_ssa(src) && src.value < nr_values && lut[src.value] &&
+             (writes_fp16_float(lut[src.value]) ||
+              writes_fp16_canonical(lut[src.value])))
+            continue;
+
+         /* Flush the whole register, the operand keeps its swizzle and
+          * modifiers. */
+         bi_builder b = bi_init_builder(ctx, bi_before_instr(I));
+         bi_instr *flush =
+            bi_flush_to(&b, 16, bi_temp(ctx), bi_strip_index(src));
+         flush->ftz = true;
+
+         I->src[s] = bi_replace_index(src, flush->dest[0]);
+      }
+
+      if (writes_fp16_float(I)) {
+         bi_index dest = I->dest[0];
+         bi_index tmp = bi_temp(ctx);
+
+         /* A converting FP32 operation writes one half: keep that, then
+          * flush it to both halves of the real destination, which FP16
+          * users read through their own swizzles. */
+         tmp.swizzle = dest.swizzle;
+         I->dest[0] = tmp;
+
+         bi_index src = tmp;
+         if (dest.swizzle == BI_SWIZZLE_H00 || dest.swizzle == BI_SWIZZLE_H11)
+            src.swizzle = dest.swizzle;
+         else
+            src.swizzle = BI_SWIZZLE_H01;
+
+         dest.swizzle = BI_SWIZZLE_H01;
+
+         bi_builder b = bi_init_builder(ctx, bi_after_instr(I));
+         bi_instr *flush = bi_flush_to(&b, 16, dest, src);
+         flush->ftz = true;
+      }
+   }
+
+   ralloc_free(lut);
+}
