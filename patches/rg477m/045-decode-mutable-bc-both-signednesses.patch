@@ -101,6 +113,29 @@ panvk_format_is_bc(VkFormat format)
           format <= VK_FORMAT_BC7_SRGB_BLOCK;
 }
 
+/* The member of the same BC class with the other signedness (BC4/BC5 UNORM
+ * and SNORM, BC6H UFLOAT and SFLOAT), VK_FORMAT_UNDEFINED for the others. */
+static inline VkFormat
+panvk_bc_other_sign(VkFormat format)
+{
+   switch (format) {
+   case VK_FORMAT_BC4_UNORM_BLOCK:
+      return VK_FORMAT_BC4_SNORM_BLOCK;
+   case VK_FORMAT_BC4_SNORM_BLOCK:
+      return VK_FORMAT_BC4_UNORM_BLOCK;
+   case VK_FORMAT_BC5_UNORM_BLOCK:
+      return VK_FORMAT_BC5_SNORM_BLOCK;
+   case VK_FORMAT_BC5_SNORM_BLOCK:
+      return VK_FORMAT_BC5_UNORM_BLOCK;
+   case VK_FORMAT_BC6H_UFLOAT_BLOCK:
+      return VK_FORMAT_BC6H_SFLOAT_BLOCK;
+   case VK_FORMAT_BC6H_SFLOAT_BLOCK:
+      return VK_FORMAT_BC6H_UFLOAT_BLOCK;
+   default:
+      return VK_FORMAT_UNDEFINED;
+   }
+}
+
 /* Storage format of the decoded plane. BC4/BC5 use 16-bit RG to keep the
  * interpolation precision; BC1-3/7 decode to RGBA8, BC6H to RGBA16F. */
