---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 88 ++++++++++++++++++---
 1 file changed, 77 insertions(+), 11 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index bb4c5959..9730642f 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -1856,6 +1856,21 @@ invalidate_unselected_crc_rts(struct cs_builder *b,
    }
 }
 
+/* get_fb_descs() builds the incremental-rendering (IR) FBD sets only for
+ * passes that can hit a tiler OOM, and emits each distinct set of frame
+ * shaders (preload/resolve DCDs) once instead of once per IR pass and layer.
+ * PANVK_NO_SPARE_FBD_REUSE=1 builds every IR set from scratch again. */
+static bool
+spare_fbd_reuse_enabled(void)
+{
+   static int disabled = -1;
+
+   if (disabled < 0)
+      disabled = debug_get_bool_option("PANVK_NO_SPARE_FBD_REUSE", false);
+
+   return !disabled;
+}
+
 static VkResult
 get_fb_descs(struct panvk_cmd_buffer *cmdbuf)
 {
@@ -2000,7 +2015,38 @@ get_fb_descs(struct panvk_cmd_buffer *cmdbuf)
    struct cs_builder *b = panvk_get_cs_builder(cmdbuf, PANVK_SUBQUEUE_FRAGMENT);
    invalidate_unselected_crc_rts(b, &fbd_info);
 
+   /* The IR FBD sets are only read by the tiler OOM handler, which runs while
+    * the tiler of this pass is out of heap memory. With no tiler context
+    * (render->tiler == 0: get_fb_descs() called from CmdEndRendering for a
+    * clear-only pass, which ends the pass), nothing is tiled and that can't
+    * happen, so skip them. Any draw allocates the tiler context first
+    * (get_render_ctx()), so a pass with draws never gets here with
+    * tiler == 0.
+    *
+    * The frame shaders depend only on (fb, load, resolve), not on the layer
+    * or the store: cmd_get_frame_shaders() reads neither, and the DCDs it
+    * emits are never patched afterwards. Without a resolve shader the main
+    * set (fb.load, resolve) equals IR_FIRST's (fb.load, NULL) and IR_MIDDLE's
+    * (spill.load, NULL) equals IR_LAST's (spill.load, resolve): no post-frame
+    * DCD is emitted for either and modes[2] stays NEVER. Reuse them then;
+    * otherwise build each IR pass's own set, once for all its layers. */
+   const bool reuse_spares = spare_fbd_reuse_enabled();
+   const bool build_ir_sets = !reuse_spares || render->tiler != 0;
+   const struct pan_fb_frame_shaders main_frame_shaders =
+      fbd_info.frame_shaders;
+   const bool has_resolve_shader =
+      main_frame_shaders.modes[2] != MALI_PRE_POST_FRAME_SHADER_MODE_NEVER;
+   struct pan_fb_frame_shaders middle_frame_shaders = {0};
+
    for (uint32_t ir_pass = 0; ir_pass < PANVK_IR_PASS_COUNT; ir_pass++) {
+      static_assert(ARRAY_SIZE(cmdbuf->state.gfx.render.ir.fbds) == PANVK_IR_PASS_COUNT,
+                    "ir.fbds array size must match PANVK_IR_PASS_COUNT");
+
+      if (!build_ir_sets) {
+         cmdbuf->state.gfx.render.ir.fbds[ir_pass] = 0;
+         continue;
+      }
+
       struct pan_ptr ir_fbds =
          panvk_cmd_alloc_dev_mem(cmdbuf, desc, fbds_sz, fbds_alignment);
 
@@ -2022,22 +2068,44 @@ get_fb_descs(struct panvk_cmd_buffer *cmdbuf)
 
       ir_store = &ir_store_without_crc;
 #endif
+      const struct pan_fb_load *ir_load = ir_pass == PANVK_IR_FIRST_PASS
+                                             ? &render->fb.load
+                                             : &render->fb.spill.load;
+      const struct pan_fb_resolve *ir_resolve =
+         ir_pass == PANVK_IR_LAST_PASS ? &render->fb.resolve : NULL;
+
+      if (reuse_spares) {
+         if (ir_pass == PANVK_IR_FIRST_PASS && !has_resolve_shader) {
+            fbd_info.frame_shaders = main_frame_shaders;
+         } else if (ir_pass == PANVK_IR_LAST_PASS && !has_resolve_shader) {
+            fbd_info.frame_shaders = middle_frame_shaders;
+         } else {
+            VkResult result = panvk_per_arch(cmd_get_frame_shaders)(
+               cmdbuf, fbd_info.fb, ir_load, ir_resolve,
+               &fbd_info.frame_shaders);
+            if (result != VK_SUCCESS)
+               return result;
+         }
+
+         if (ir_pass == PANVK_IR_MIDDLE_PASS)
+            middle_frame_shaders = fbd_info.frame_shaders;
+      }
+
       for (uint32_t i = 0; i < enabled_layer_count; i++) {
          uint32_t layer_idx = multiview ? u_bit_scan(&ir_view_mask_temp) : i;
 
          fbd_info.layer = layer_idx;
          tiler_ctx = get_tiler_context(cmdbuf, layer_idx);
-         fbd_info.load = ir_pass == PANVK_IR_FIRST_PASS
-                            ? &render->fb.load
-                            : &render->fb.spill.load;
+         fbd_info.load = ir_load;
          fbd_info.store = ir_store;
 
-         VkResult result = panvk_per_arch(cmd_get_frame_shaders)(
-            cmdbuf, fbd_info.fb, fbd_info.load,
-            ir_pass == PANVK_IR_LAST_PASS ? &render->fb.resolve : NULL,
-            &fbd_info.frame_shaders);
-         if (result != VK_SUCCESS)
-            return result;
+         if (!reuse_spares) {
+            VkResult result = panvk_per_arch(cmd_get_frame_shaders)(
+               cmdbuf, fbd_info.fb, ir_load, ir_resolve,
+               &fbd_info.frame_shaders);
+            if (result != VK_SUCCESS)
+               return result;
+         }
 
          const struct pan_ptr fbd = pan_ptr_offset(ir_fbds, fbd_sz * i);
          const struct pan_fb_descs fb_descs = {
@@ -2058,8 +2126,6 @@ get_fb_descs(struct panvk_cmd_buffer *cmdbuf)
          assert(new_fbd_flags == fbd_flags);
       }
 
-      static_assert(ARRAY_SIZE(cmdbuf->state.gfx.render.ir.fbds) == PANVK_IR_PASS_COUNT,
-                    "ir.fbds array size must match PANVK_IR_PASS_COUNT");
       cmdbuf->state.gfx.render.ir.fbds[ir_pass] = ir_fbds.gpu;
    }
 
